<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EZStudio Plateforme{% endblock %}</title>

    {# Bootstrap 5.3 CSS #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    {# CSS commun EZStudio #}
    <link rel="stylesheet" href="{{ asset('shared/css/ezstudio-shared.css') }}">

    {% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    {% include '@shared/_navbar.html.twig' %}

    <main class="container my-4 flex-grow-1">
        {% block body %}{% endblock %}
    </main>

    {% include '@shared/_footer.html.twig' %}

    {# jQuery 3.7 + Bootstrap 5.3 Bundle JS #}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    {# JS commun EZStudio #}
    <script src="{{ asset('shared/js/ezstudio-shared.js') }}"></script>

    {% block javascripts %}{% endblock %}
{% if app.environment == 'dev' %}
<footer style="padding:12px 20px;text-align:right;font-size:12px"><a href="/_profiler" target="_blank" rel="noopener noreferrer" style="color:#8b949e;text-decoration:none">Symfony Profiler</a> <a href="/_profiler-export" style="margin-left:10px;color:#c9d1d9;text-decoration:none;border:1px solid #464c54;padding:2px 8px;border-radius:4px">Export Profiler</a></footer>
{% endif %}
</body>
</html>
