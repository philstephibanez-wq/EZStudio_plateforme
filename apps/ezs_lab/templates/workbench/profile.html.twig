{% extends 'base.html.twig' %}
{% import 'workbench/_pipeline_table.html.twig' as ezs_pipeline %}
{% set ezs_pipeline_locale = app.request.attributes.get('_locale') ?: 'fr' %}
{% block title %}PROFILE · EZStudio_lab{% endblock %}
{% block body %}
<style>
.prof-ui .card{padding:12px 14px;margin-bottom:10px}
.prof-ui h1{font-size:18px;margin:0}
.prof-ui h2{font-size:14px;margin:0}
.prof-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start}
@media(max-width:1100px){.prof-grid-2{grid-template-columns:1fr}}
.prof-bar{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;min-height:30px}
.prof-actions{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.prof-prog-box{margin-bottom:8px;padding:6px 8px;min-height:36px;display:flex;flex-direction:column;justify-content:center;background:rgba(255,255,255,0.03);border:1px solid var(--line);border-radius:4px}
.prof-tbl{width:100%;border-collapse:collapse;font-size:12px}
.prof-tbl th,.prof-tbl td{padding:5px 6px;height:30px;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}
.prof-tbl th{font-size:11px;text-transform:uppercase;color:var(--muted)}
/* Pipelines techniques : seuls les entêtes sont différenciés, jamais les résultats ni le corps. */
.prof-ui details.ezs-tech-pipeline > summary{
  padding:6px 8px;
  background:rgba(78,112,159,.14);
  border:1px solid var(--line);
  border-radius:4px;
}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl{
  width:100%;
  table-layout:fixed;
}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl thead th{
  background:rgba(78,112,159,.14);
}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl :is(th,td):nth-child(1){width:5%}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl :is(th,td):nth-child(2){width:30%}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl :is(th,td):nth-child(3){width:29%}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl :is(th,td):nth-child(4){width:16%}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl :is(th,td):nth-child(5){width:11%}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl :is(th,td):nth-child(6){width:9%}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl tbody td{
  overflow:hidden;
  text-overflow:ellipsis;
}

.icon-btn{padding:3px 8px;font-size:13px;line-height:1.2;cursor:pointer}
</style>
<div class="prof-ui">
<section class="card" id="part-1-song-card" {% if selected_song %}data-identity-url="{{ path('profile_song_identity', {id: selected_song.id}) }}"{% endif %}>
  <div class="row" style="justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
      <span class="badge">1 · Chanson</span>
      {% if selected_song %}
        <div>
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <label for="inplace-title" style="display:flex;flex-direction:column;gap:2px;font-size:11px;font-weight:600;letter-spacing:0.04em;text-transform:uppercase;color:#cbd5e1">Titre<input type="text" id="inplace-title" value="{{ selected_song.title }}" readonly aria-label="Titre" placeholder="Titre" style="font-size:15px;font-weight:700;width:clamp(220px,24vw,340px);padding:5px 9px;border-radius:5px;border:1px solid var(--line);background:rgba(255,255,255,0.03);color:inherit"></label>
            <label for="inplace-artist" style="display:flex;flex-direction:column;gap:2px;font-size:11px;font-weight:600;letter-spacing:0.04em;text-transform:uppercase;color:#cbd5e1">Interprète<input type="text" id="inplace-artist" value="{{ selected_song.artist }}" readonly aria-label="Interprète" placeholder="Interprète" style="font-size:15px;font-weight:700;width:clamp(220px,24vw,340px);padding:5px 9px;border-radius:5px;border:1px solid var(--line);background:rgba(255,255,255,0.03);color:inherit"></label>
            <button type="button" id="song-edit-toggle" class="secondary icon-btn" title="Modifier le titre et l'interprète">✎</button>
            <button type="button" id="song-edit-save" style="display:none;padding:5px 10px;font-size:12px">Valider</button>
            <button type="button" id="song-edit-cancel" class="secondary" style="display:none;padding:5px 9px;font-size:12px">Annuler</button>
          </div>
          {% if selected_song.source_filename is defined and selected_song.source_filename %}<div class="meta" style="font-size:11px;margin-top:2px">{{ selected_song.source_filename }}</div>{% endif %}
        </div>
        <span id="song-identity-message" class="meta" style="font-size:11px"></span>
        <span class="meta">#{{ selected_song.id }}{% if selected_profile_run and selected_profile_run.metrics.duration_seconds is defined %} · {{ selected_profile_run.metrics.duration_seconds|number_format(1) }} s{% endif %}</span>
      {% else %}<h1>PROFILE</h1>{% endif %}
    </div>
    {% if selected_profile_run %}
      <form method="post" action="{{ path('profile_scientific_export', {id: selected_profile_run.id}) }}" style="margin:0">
        <button type="submit" class="secondary" title="Télécharger les résultats PROFILE et les expertises enregistrées">Exporter analyse + expertise</button>
      </form>
    {% endif %}
  </div>
</section>
<script>
(function(){
  document.getElementById('copy-diag-btn')?.addEventListener('click',async function(e){
    e.preventDefault();e.stopPropagation();
    const p=document.getElementById('diag-json-pre');if(!p)return;
    const txt=p.textContent||'';
    try{
      if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(txt);}
      else{throw new Error('fallback');}
    }catch(_){
      const ta=document.createElement('textarea');ta.value=txt;ta.style.position='fixed';ta.style.opacity='0';
      document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);
    }
    const st=document.getElementById('copy-diag-status');if(st){st.style.display='inline';setTimeout(()=>{st.style.display='none';},2000);}
  });
  const card=document.getElementById('part-1-song-card'), tEl=document.getElementById('inplace-title'), aEl=document.getElementById('inplace-artist'), pen=document.getElementById('song-edit-toggle'), btnSave=document.getElementById('song-edit-save'), btnCancel=document.getElementById('song-edit-cancel'), msg=document.getElementById('song-identity-message');
  if(tEl && aEl && card){
    let origT=tEl.value.trim(), origA=aEl.value.trim(); const url=card.dataset.identityUrl||'';
    const setEdit=(on)=>{[tEl,aEl].forEach(el=>{el.readOnly=!on;el.style.borderColor=on?'#4ea1ff':'var(--line)';el.style.background=on?'rgba(255,255,255,0.09)':'rgba(255,255,255,0.03)';});if(pen)pen.style.display=on?'none':'inline-block';if(btnSave)btnSave.style.display=on?'inline-block':'none';if(btnCancel)btnCancel.style.display=on?'inline-block':'none';if(on){tEl.focus();tEl.select();}};
    const cancelEdit=()=>{tEl.value=origT;aEl.value=origA;setEdit(false);};
    const saveEdit=async()=>{const nt=tEl.value.trim(),na=aEl.value.trim();if(!url||!nt||!na){return;}if(nt===origT&&na===origA){setEdit(false);return;}msg.textContent='Enregistrement…';btnSave.disabled=true;try{const fd=new FormData();fd.append('title',nt);fd.append('artist',na);const r=await fetch(url,{method:'POST',credentials:'same-origin',headers:{'X-EZS-Song-Identity':'save'},body:fd});if(!r.ok)throw new Error(r.status);origT=nt;origA=na;setEdit(false);msg.textContent='Enregistré';setTimeout(()=>msg.textContent='',2000);}catch(_){msg.textContent='Erreur';}finally{btnSave.disabled=false;}};
    pen?.addEventListener('click',()=>setEdit(true)); btnCancel?.addEventListener('click',cancelEdit); btnSave?.addEventListener('click',saveEdit);
    [tEl,aEl].forEach(el=>el.addEventListener('keydown',(e)=>{if(el.readOnly)return;if(e.key==='Enter'){e.preventDefault();saveEdit();}else if(e.key==='Escape'){e.preventDefault();cancelEdit();}}));
  }
})();
</script>
{% if selected_song %}
<div class="prof-grid-2">
  <section class="card" id="part-2-analysis">
    <div class="prof-bar">
      <div><span class="badge">2 · Analyse LAB</span> <h2 style="display:inline-block;margin-left:6px">Résultats &amp; Logique</h2></div>
      <div class="prof-actions">
        <form method="post" action="{{ path('profile_analyze') }}" style="margin:0"><input type="hidden" name="song" value="{{ selected_song.id }}"><button type="submit">Analyser</button></form>
        <button type="button" class="secondary" id="profile-live-cancel" disabled>Annuler</button>
        <form method="get" action="{{ path('workbench_profile') }}" style="margin:0"><input type="hidden" name="song" value="{{ selected_song.id }}"><select name="run" onchange="this.form.submit()" style="font-size:11px">{% for r in profile_runs %}<option value="{{ r.id }}" {{ selected_profile_run and r.id == selected_profile_run.id ? 'selected' : '' }}>{{ r.public_id }} · {{ r.state }}</option>{% else %}<option>Aucun run</option>{% endfor %}</select></form>
      </div>
    </div>
    <div id="profile-step-observer" class="prof-prog-box" data-ezs-observability="r1">
      <div class="row" style="justify-content:space-between;font-size:11px"><span id="profile-step-state" class="meta">{{ selected_profile_run ? ('Run #' ~ selected_profile_run.id ~ ' · ' ~ selected_profile_run.state) : 'Prêt' }}</span><span id="profile-step-current" class="meta"></span></div>
      <progress id="profile-step-progress" value="{{ selected_profile_run and selected_profile_run.state == 'done' ? 100 : 0 }}" max="100" style="width:100%;height:8px;margin-top:4px"></progress>
    </div>
    {% if selected_profile_run %}
      {% set p = selected_profile_run.metrics %}{% set pv = selected_profile_run.diagnostics.profile_view ?? {} %}{% set vox = pv.vocal_profile.dimensions ?? {} %}
      <table class="prof-tbl">
        <thead><tr><th>Dimension</th><th>Résultat LAB</th><th>Détail</th></tr></thead>
        <tbody>
          <tr><td><strong>Durée</strong></td><td>{% if p.duration_seconds is defined %}{{ (p.duration_seconds / 60)|round(0, 'floor') }}:{{ '%02d'|format((p.duration_seconds % 60)|round(0, 'floor')) }}{% else %}—{% endif %}</td><td class="meta">{% if p.duration_seconds is defined %}{{ p.duration_seconds|number_format(2) }} s{% endif %}</td></tr>
          <tr><td><strong>Tempo</strong></td><td>{% if p.tempo.bpm is defined %}{{ p.tempo.bpm|number_format(2) }} BPM{% else %}—{% endif %}</td><td class="meta">{% if p.tempo.confidence is defined %}{{ (p.tempo.confidence * 100)|number_format(0) }}%{% endif %}</td></tr>
          <tr><td><strong>Mesure</strong></td><td>{{ p.time_signature.label ?? p.time_signature.suggested_label ?? '—' }}</td><td class="meta">{% if p.time_signature.confidence is defined %}{{ (p.time_signature.confidence * 100)|number_format(0) }}%{% endif %}</td></tr>
          <tr><td><strong>Tonalité</strong></td><td>{{ pv.tonal.label ?? p.key.label ?? '—' }}</td><td class="meta">{% if p.key.confidence is defined %}{{ (p.key.confidence * 100)|number_format(0) }}%{% endif %}</td></tr>
          <tr><td><strong>Genre</strong></td><td>{{ pv.genre_hierarchy.primary.genre ?? '—' }}</td><td class="meta">{% if profile_summary and profile_summary.genres %}{% for x in profile_summary.genres|slice(0,3) %}{{ x.label }} ({{ (x.score*100)|number_format(0) }}%){% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</td></tr>
          {% set insts = pv.instrumentation.candidates ?? [] %}
          {% for inst in insts %}
            <tr><td><strong>Instrument {{ loop.index }}</strong></td><td>{{ inst.label }}</td><td class="meta">{% if inst.score is defined and inst.score is not null %}{{ (inst.score * 100)|number_format(0) }}%{% else %}CLAP / AudioSet{% endif %}</td></tr>
          {% else %}
            <tr><td><strong>Instruments</strong></td><td>—</td><td class="meta">Aucun</td></tr>
          {% endfor %}
          <tr><td><strong>Voix principale</strong></td><td>{{ vox.lead_vocal.decision ?? '—' }}</td><td class="meta">lead_vocal</td></tr>
          <tr><td><strong>Voix accomp.</strong></td><td>{{ vox.backing_vocals.decision ?? '—' }}</td><td class="meta">backing_vocals</td></tr>
          <tr><td><strong>Harmonies</strong></td><td>{{ vox.vocal_harmonies.decision ?? '—' }}</td><td class="meta">vocal_harmonies</td></tr>
          <tr><td><strong>Chœur</strong></td><td>{{ vox.choir.decision ?? '—' }}</td><td class="meta">choir</td></tr>
        </tbody>
      </table>
      {% set completed_modules = selected_profile_run.diagnostics.module_registry.modules ?? [] %}
      {% if completed_modules is not empty or selected_song %}
        <details class="ezs-tech-pipeline" id="profile-modules-details" style="margin-top:24px"><summary id="profile-modules-summary" style="cursor:pointer;font-size:11px;font-weight:600">Logique : Pipeline des {{ completed_modules|length }} moteurs · run #{{ selected_profile_run.id }}</summary>
          <table class="prof-tbl" data-ezs-observability="r2" style="margin-top:4px">{{ ezs_pipeline.header(ezs_pipeline_locale) }}<tbody id="profile-module-rows">
            <tr id="profile-live-pipeline-row" hidden><td colspan="6" id="profile-live-pipeline" class="meta" role="status" aria-live="polite"></td></tr>
            {% for m in completed_modules %}
              {% set ezs_lab_raw = m.display_name ?? m.name ?? m.module_id ?? m.id ?? '' %}
              {% set ezs_lab_name = ezs_lab_raw|replace({'_':' '}) %}
              {% set ezs_lab_code = ezs_lab_raw|lower %}
              {% set ezs_lab_step_id = 'processing' %}
              {% if 'tonal' in ezs_lab_code or 'key' in ezs_lab_code %}
                {% set ezs_lab_step_id = 'tonality' %}
              {% elseif 'beat' in ezs_lab_code or 'rhythm' in ezs_lab_code %}
                {% set ezs_lab_step_id = 'rhythm' %}
              {% elseif 'meter' in ezs_lab_code %}
                {% set ezs_lab_step_id = 'meter' %}
              {% elseif 'tuning' in ezs_lab_code %}
                {% set ezs_lab_step_id = 'tuning' %}
              {% elseif 'clap' in ezs_lab_code or 'passt' in ezs_lab_code or 'panns' in ezs_lab_code %}
                {% set ezs_lab_step_id = 'semantic' %}
              {% elseif 'mert' in ezs_lab_code or 'embedding' in ezs_lab_code %}
                {% set ezs_lab_step_id = 'embedding' %}
              {% elseif 'descriptor' in ezs_lab_code %}
                {% set ezs_lab_step_id = 'descriptors' %}
              {% endif %}
              {% set ezs_lab_step_name = ('ezs.profile.step.' ~ ezs_lab_step_id)|trans({}, 'ezs_profile', ezs_pipeline_locale) %}
              {% set ezs_lab_status = (m.status ?? '')|lower %}
              {% set ezs_lab_status_key = ezs_lab_status in ['ok','completed','degraded','error','failed','skipped','running','pending','blocked'] ? 'ezs.profile.status.' ~ ezs_lab_status : 'ezs.profile.status.unknown' %}
              {{ ezs_pipeline.row(loop.index, (m.step_label ?? m.phase_label ?? ezs_lab_step_name), ezs_lab_name, m.device ?? null, ezs_lab_status_key|trans({}, 'ezs_profile', ezs_pipeline_locale), m.timing.elapsed_seconds ?? null, ezs_lab_raw) }}
            {% endfor %}
          </tbody></table>
        </details>
      {% endif %}
    {% else %}
      <details class="ezs-tech-pipeline" id="profile-modules-details" style="margin-top:24px" open>
        <summary id="profile-modules-summary">Logique : Pipeline PROFILE · en attente</summary>
        <table class="prof-tbl">{{ ezs_pipeline.header(ezs_pipeline_locale) }}
          <tbody id="profile-module-rows"><tr><td colspan="6">{{ 'ezs.profile.table.lab_pending'|trans({}, 'ezs_profile', ezs_pipeline_locale) }}</td></tr></tbody>
        </table>
      </details>
    {% endif %}
  </section>
  <style>
.v-badge-tip{position:relative;display:inline-block;cursor:help}
.v-badge-tip .v-badge-pop{display:none;position:absolute;left:50%;bottom:calc(100% + 6px);transform:translateX(-50%);width:290px;padding:8px 10px;border-radius:6px;background:#0f172a;color:#e2e8f0;border:1px solid #334155;box-shadow:0 8px 20px rgba(0,0,0,.5);font-size:11px;font-weight:400;line-height:1.4;text-transform:none;letter-spacing:normal;text-align:left;z-index:60;white-space:normal}
.v-badge-tip:hover .v-badge-pop,.v-badge-tip:focus .v-badge-pop{display:block}
</style>
<style>
.prof-tbl th,.prof-tbl td{height:36px;padding-top:4px;padding-bottom:4px;vertical-align:middle;white-space:nowrap}
.prof-tbl .ana-cell{max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
</style>
<section class="card" id="part-3-expertise">
    <div class="prof-bar">
      <div><span class="badge">3 · Expertise IA</span> <h2 style="display:inline-block;margin-left:6px">Verdicts &amp; Preuves</h2></div>
      <div class="prof-actions">
        {% if selected_profile_run and selected_profile_run.state == 'done' %}
          <button type="button" id="profile-ai-run-button">Expertiser</button>
          <button type="button" class="secondary" id="profile-ai-cancel-button" disabled>Annuler</button>
        {% endif %}
        {% set revs = profile_external_revisions ?? [] %}
        {% set history_revs = song_external_revisions ?? [] %}
        <select id="expertise-history-select" style="font-size:11px">
          {% if history_revs is not empty and revs is empty %}<option value="" selected>Historique des expertises</option>{% endif %}{% for rev in history_revs %}<option value="exp-rev-{{ rev.id }}" data-run="{{ rev.run_id }}" {{ revs is not empty and selected_profile_run and rev.run_id == selected_profile_run.id and rev.id == (revs|first).id ? 'selected' : '' }}>#{{ rev.id }} (run #{{ rev.run_id }}) · {{ rev.status }}</option>{% else %}<option>Aucune expertise</option>{% endfor %}
        </select>
      </div>
    </div>

    {% if selected_profile_run and selected_profile_run.state == 'done' %}
      <div id="profile-ai-request" class="prof-prog-box" data-url="{{ path('profile_ai_review_status', {id: selected_profile_run.id}) }}" data-action="{{ path('profile_ai_review_request', {id: selected_profile_run.id}) }}" data-cancel-url="{{ path('profile_ai_review_cancel', {id: selected_profile_run.id}) }}">
        <div class="row" style="justify-content:space-between;font-size:11px"><span id="profile-ai-request-state" class="meta">Prêt</span><span id="profile-ai-step-current" class="meta"></span></div>
        <progress id="profile-ai-progress" max="100" value="0" style="width:100%;height:8px;margin-top:4px"></progress>

      </div>
    {% endif %}

    <div id="profile-ai-revisions">
    {% set sum = profile_summary ?? {} %}
    {% set vox = sum.voices ?? {} %}
    {% set base_rows = [
      {'keys':['duration','duree'], 'label':'Durée', 'lab': (sum.duration is defined and sum.duration is not null ? ((sum.duration / 60)|round(0,'floor') ~ ':' ~ '%02d'|format((sum.duration % 60)|round(0,'floor'))) : '—')},
      {'keys':['tempo'], 'label':'Tempo', 'lab': (sum.tempo is defined and sum.tempo is not null ? (sum.tempo|number_format(2) ~ ' BPM') : '—')},
      {'keys':['meter','mesure'], 'label':'Mesure', 'lab': sum.meter ?? '—'},
      {'keys':['key','tonalite'], 'label':'Tonalité', 'lab': sum.key ?? '—'},
      {'keys':['genre'], 'label':'Genre', 'lab': sum.genre ?? '—'}
    ] %}
    {# R2.2 : mêmes instruments, même ordre, que le tableau Analyse LAB du run affiché. #}
    {% set aligned_instruments = selected_profile_run ? (selected_profile_run.diagnostics.profile_view.instrumentation.candidates ?? []) : [] %}
    {% for inst in aligned_instruments %}
      {% set idx = loop.index0 %}
      {% set base_rows = base_rows|merge([{'keys':['instruments:' ~ idx, 'instrument:' ~ idx], 'label':'Instrument ' ~ (idx + 1), 'lab': inst.label ?? '—'}]) %}
    {% else %}
      {# Le tableau Analyse LAB affiche également une ligne unique « Instruments » sans candidats. #}
      {% if selected_profile_run %}
        {% set base_rows = base_rows|merge([{'keys':['instruments'], 'label':'Instruments', 'lab':'—'}]) %}
      {% endif %}
    {% endfor %}
    {% set base_rows = base_rows|merge([
      {'keys':['lead_vocal','voix_principale'], 'label':'Voix principale', 'lab': vox.lead.decision ?? vox.lead ?? '—'},
      {'keys':['backing_vocals','voix_accompagnement'], 'label':'Voix accomp.', 'lab': vox.backing.decision ?? vox.backing ?? '—'},
      {'keys':['vocal_harmonies','harmonies_vocales'], 'label':'Harmonies', 'lab': vox.harmonies.decision ?? vox.harmonies ?? '—'},
      {'keys':['choir','choeurs'], 'label':'Chœur', 'lab': vox.choir.decision ?? vox.choir ?? '—'}
    ]) %}

    {% set panels_list = revs is not empty ? revs : [{'id': 0, 'comparison': {'final_verification': {'assertions': []}}}] %}
    {% for revision in panels_list %}
      {% set fv = revision.comparison.final_verification ?? {} %}{% set assertions = fv.assertions ?? [] %}
      <div class="exp-rev-panel" id="exp-rev-{{ revision.id }}" style="{{ not loop.first ? 'display:none' : '' }}">
        <table class="prof-tbl">
          <thead><tr><th>Dimension</th><th>LAB</th><th>Verdict</th><th>Externe</th><th>Analyse &amp; Sources</th></tr></thead>
          <tbody>
            {% for row_def in base_rows %}
              {% set found = null %}
              {% for item in assertions %}
                {% if item.key in row_def.keys and found is null %}
                  {% set found = item %}
                {% endif %}
              {% endfor %}
              {% set v = found.verdict ?? 'non_trouve' %}
              {% set badge_cls = v == 'bon' ? 'ok' : (v == 'faux' ? 'warn' : '') %}
              {% set web_item = null %}
              {% for web_row in (fv.web_investigation.items ?? []) %}
                {% if web_row.key in row_def.keys and web_item is null %}{% set web_item = web_row %}{% endif %}
              {% endfor %}
              {% set search_failure = (web_item.status ?? '') == 'error' or (fv.web_investigation.status ?? '') == 'error' %}
              {% set badge_lbl = v == 'bon' ? 'BON' : (v == 'faux' ? 'FAUX' : (found is null ? 'SANS EXPERTISE' : (search_failure ? 'RECHERCHE EN ERREUR' : 'NON VÉRIFIÉ'))) %}
              {% set v_desc = v == 'bon' ? 'BON : une source indépendante confirme directement l’analyse LAB.' : (v == 'faux' ? 'FAUX : une source indépendante contredit l’analyse LAB.' : (search_failure ? 'Recherche Web en erreur ; aucune conclusion documentaire possible.' : 'Vérification documentaire insuffisante ; ce statut ne signifie pas absence de recherche.')) %}
              {% set v_detail = found.reason ?? found.documentary_observation.reason ?? (revs is empty ? 'Aucune expertise lancée sur ce run.' : 'En attente de vérification sur ce point.') %}
              {% set raw_ref = found.reference_value ?? found.documentary_observation.reference_value ?? '' %}
              {% set disp_ref = (row_def.label == 'Durée' and raw_ref matches '/^[0-9.]+$/') ? ((raw_ref / 60)|round(0,'floor') ~ ':' ~ '%02d'|format((raw_ref % 60)|round(0,'floor'))) : (raw_ref ?: '—') %}
              <tr>
                <td><strong>{{ row_def.label }}</strong></td>
