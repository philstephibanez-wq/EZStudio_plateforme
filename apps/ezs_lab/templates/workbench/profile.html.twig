                  {{ ezs_pipeline.row(loop.index, ezs_engine_key ? ezs_engine_key|trans({}, 'ezs_profile', ezs_expertise_locale) : (ezs_engine_id ? ezs_engine_id|replace({'_':' '})|capitalize : '—'), ezs_engine_id ? ezs_engine_id|replace({'_':' '})|title : '—', ezs_device, ezs_status_key|trans({}, 'ezs_profile', ezs_expertise_locale), engine_step.duration_ms is defined and engine_step.duration_ms is not null ? engine_step.duration_ms / 1000 : null, ezs_engine_id) }}
              {% else %}
                <tr><td colspan="6" class="meta">{{ 'ezs.profile.table.no_details'|trans({}, 'ezs_profile', ezs_expertise_locale) }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </details>
      </div>
    {% endfor %}
    </div>
  </section>
