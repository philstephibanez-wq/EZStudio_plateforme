{% extends 'base.html.twig' %}
{% import 'workbench/_pipeline_table.html.twig' as ezs_pipeline %}
{% set ezs_pipeline_locale = app.request.attributes.get('_locale') ?: 'fr' %}
{% block title %}PROFILE · EZStudio_lab{% endblock %}
{% block body %}
<style>
.prof-ui .card{padding:12px 14px;margin-bottom:10px}
.prof-ui h1{font-size:18px;margin:0}
.prof-ui h2{font-size:14px;margin:0}
.prof-grid-2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;align-items:start}
@media(max-width:1100px){.prof-grid-2{grid-template-columns:minmax(0,1fr)}}
.prof-prog-box progress{display:block;width:100%;height:8px;margin-top:4px;appearance:none;-webkit-appearance:none;border:0;border-radius:0;background:#263444;color:#6387af}
.prof-prog-box progress::-webkit-progress-bar{background:#263444;border-radius:0}
.prof-prog-box progress::-webkit-progress-value{background:#6387af;border-radius:0}
.prof-prog-box progress::-moz-progress-bar{background:#6387af;border-radius:0}
.profile-expertise-steps{display:flex;flex-wrap:wrap;gap:0 .35rem;list-style:none;margin:0;padding:0;font-size:11px}
.profile-expertise-steps li{color:inherit;opacity:.65}
.profile-expertise-steps li+li::before{content:"›";margin-right:.35rem;opacity:.65}
.profile-expertise-steps li[data-state="done"]{opacity:.9}
.profile-expertise-steps li[aria-current="step"]{opacity:1;color:#9bcaff;font-weight:700}
.profile-expertise-steps li[data-state="failed"]{color:#ffaaa5}
.prof-bar{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;min-height:30px}
.prof-actions{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.prof-prog-box{margin-bottom:8px;padding:6px 8px;min-height:36px;display:flex;flex-direction:column;justify-content:center;background:rgba(255,255,255,0.03);border:1px solid var(--line);border-radius:4px}
.prof-tbl{width:100%;table-layout:fixed;border-collapse:collapse;font-size:12px}
.prof-grid-2 > *{min-width:0}
#profile-expertise-column{display:grid;gap:12px}
#profile-expertise-table td{overflow-wrap:anywhere}
#profile-expertise-table th:nth-child(1){width:25%}
#profile-expertise-table th:nth-child(2){width:50%}
#profile-expertise-table th:nth-child(3){width:25%}
#profile-expertise-table [hidden]{display:none}
.prof-tbl th,.prof-tbl td{white-space:normal;overflow-wrap:anywhere}
#profile-canonical-results .prof-tbl th:nth-child(1){width:25%}
#profile-canonical-results .prof-tbl th:nth-child(2){width:50%}
#profile-canonical-results .prof-tbl th:nth-child(3){width:25%}
.prof-tbl th,.prof-tbl td{padding:5px 6px;height:30px;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}
.prof-tbl th{font-size:11px;text-transform:uppercase;color:var(--muted)}
/* Pipelines techniques : seuls les entêtes sont différenciés, jamais les résultats ni le corps. */
.prof-ui details.ezs-tech-pipeline > summary{
  padding:6px 8px;
  background:rgba(78,112,159,.14);
  border:1px solid var(--line);
  border-radius:4px;
}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl{
  width:100%;
  table-layout:fixed;
}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl thead th{
  background:rgba(78,112,159,.14);
}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl :is(th,td):nth-child(1){width:5%}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl :is(th,td):nth-child(2){width:30%}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl :is(th,td):nth-child(3){width:29%}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl :is(th,td):nth-child(4){width:16%}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl :is(th,td):nth-child(5){width:11%}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl :is(th,td):nth-child(6){width:9%}
.prof-ui details.ezs-tech-pipeline > table.prof-tbl tbody td{
  overflow:hidden;
  text-overflow:ellipsis;
}

.icon-btn{padding:3px 8px;font-size:13px;line-height:1.2;cursor:pointer}
</style>
<div class="prof-ui">
<section class="card" id="part-1-song-card" {% if selected_song %}data-identity-url="{{ path('profile_song_identity', {id: selected_song.id}) }}"{% endif %}>
  <div class="row" style="justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
      <span class="badge">1 · Chanson</span>
      {% if selected_song %}
        <div>
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <label for="inplace-title" style="display:flex;flex-direction:column;gap:2px;font-size:11px;font-weight:600;letter-spacing:0.04em;text-transform:uppercase;color:#cbd5e1">Titre<input type="text" id="inplace-title" value="{{ selected_song.title }}" readonly aria-label="Titre" placeholder="Titre" style="font-size:15px;font-weight:700;width:clamp(220px,24vw,340px);padding:5px 9px;border-radius:5px;border:1px solid var(--line);background:rgba(255,255,255,0.03);color:inherit"></label>
            <label for="inplace-artist" style="display:flex;flex-direction:column;gap:2px;font-size:11px;font-weight:600;letter-spacing:0.04em;text-transform:uppercase;color:#cbd5e1">Interprète<input type="text" id="inplace-artist" value="{{ selected_song.artist }}" readonly aria-label="Interprète" placeholder="Interprète" style="font-size:15px;font-weight:700;width:clamp(220px,24vw,340px);padding:5px 9px;border-radius:5px;border:1px solid var(--line);background:rgba(255,255,255,0.03);color:inherit"></label>
            <button type="button" id="song-edit-toggle" class="secondary icon-btn" title="Modifier le titre et l'interprète">✎</button>
            <button type="button" id="song-edit-save" style="display:none;padding:5px 10px;font-size:12px">Valider</button>
            <button type="button" id="song-edit-cancel" class="secondary" style="display:none;padding:5px 9px;font-size:12px">Annuler</button>
          </div>
          {% if selected_song.source_filename is defined and selected_song.source_filename %}<div class="meta" style="font-size:11px;margin-top:2px">{{ selected_song.source_filename }}</div>{% endif %}
        </div>
        <span id="song-identity-message" class="meta" style="font-size:11px"></span>
        <span class="meta">#{{ selected_song.id }}{% if selected_profile_run and selected_profile_run.metrics.duration_seconds is defined %} · {{ selected_profile_run.metrics.duration_seconds|number_format(1) }} s{% endif %}</span>
      {% else %}<h1>PROFILE</h1>{% endif %}
    </div>
  </div>
</section>
<script>
(function(){
  document.getElementById('copy-diag-btn')?.addEventListener('click',async function(e){
    e.preventDefault();e.stopPropagation();
    const p=document.getElementById('diag-json-pre');if(!p)return;
    const txt=p.textContent||'';
    try{
      if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(txt);}
      else{throw new Error('fallback');}
    }catch(_){
      const ta=document.createElement('textarea');ta.value=txt;ta.style.position='fixed';ta.style.opacity='0';
      document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);
    }
    const st=document.getElementById('copy-diag-status');if(st){st.style.display='inline';setTimeout(()=>{st.style.display='none';},2000);}
  });
  const card=document.getElementById('part-1-song-card'), tEl=document.getElementById('inplace-title'), aEl=document.getElementById('inplace-artist'), pen=document.getElementById('song-edit-toggle'), btnSave=document.getElementById('song-edit-save'), btnCancel=document.getElementById('song-edit-cancel'), msg=document.getElementById('song-identity-message');
  if(tEl && aEl && card){
    let origT=tEl.value.trim(), origA=aEl.value.trim(); const url=card.dataset.identityUrl||'';
    const setEdit=(on)=>{[tEl,aEl].forEach(el=>{el.readOnly=!on;el.style.borderColor=on?'#4ea1ff':'var(--line)';el.style.background=on?'rgba(255,255,255,0.09)':'rgba(255,255,255,0.03)';});if(pen)pen.style.display=on?'none':'inline-block';if(btnSave)btnSave.style.display=on?'inline-block':'none';if(btnCancel)btnCancel.style.display=on?'inline-block':'none';if(on){tEl.focus();tEl.select();}};
    const cancelEdit=()=>{tEl.value=origT;aEl.value=origA;setEdit(false);};
    const saveEdit=async()=>{const nt=tEl.value.trim(),na=aEl.value.trim();if(!url||!nt||!na){return;}if(nt===origT&&na===origA){setEdit(false);return;}msg.textContent='Enregistrement…';btnSave.disabled=true;try{const fd=new FormData();fd.append('title',nt);fd.append('artist',na);const r=await fetch(url,{method:'POST',credentials:'same-origin',headers:{'X-EZS-Song-Identity':'save'},body:fd});if(!r.ok)throw new Error(r.status);origT=nt;origA=na;setEdit(false);msg.textContent='Enregistré';setTimeout(()=>msg.textContent='',2000);}catch(_){msg.textContent='Erreur';}finally{btnSave.disabled=false;}};
    pen?.addEventListener('click',()=>setEdit(true)); btnCancel?.addEventListener('click',cancelEdit); btnSave?.addEventListener('click',saveEdit);
    [tEl,aEl].forEach(el=>el.addEventListener('keydown',(e)=>{if(el.readOnly)return;if(e.key==='Enter'){e.preventDefault();saveEdit();}else if(e.key==='Escape'){e.preventDefault();cancelEdit();}}));
  }
})();
</script>
{% if selected_song %}
<div class="prof-grid-2">
  <section class="card" id="part-2-analysis">
    <div class="prof-bar">
      <div><span class="badge">2 · Analyse LAB</span> <h2 style="display:inline-block;margin-left:6px">Résultats &amp; Logique</h2></div>
      <div class="prof-actions">
        <form method="post" action="{{ path('profile_analyze') }}" style="margin:0"><input type="hidden" name="song" value="{{ selected_song.id }}"><button type="submit">Analyser</button></form>
        <button type="button" class="secondary" id="profile-live-cancel" disabled>Annuler</button>
        <form method="get" action="{{ path('workbench_profile') }}" style="margin:0"><input type="hidden" name="song" value="{{ selected_song.id }}"><select name="run" onchange="this.form.submit()" style="font-size:11px">{% for r in profile_runs %}<option value="{{ r.id }}" {{ selected_profile_run and r.id == selected_profile_run.id ? 'selected' : '' }}>{{ r.public_id }} · {{ r.state }}</option>{% else %}<option>Aucun run</option>{% endfor %}</select></form>
      </div>
    </div>
    <div id="profile-step-observer" class="prof-prog-box" data-ezs-observability="r1">
      <div class="row" style="justify-content:space-between;font-size:11px"><span id="profile-step-state" class="meta">{{ selected_profile_run ? ('Run #' ~ selected_profile_run.id ~ ' · ' ~ selected_profile_run.state) : 'Prêt' }}</span><span id="profile-step-current" class="meta"></span></div>
      <progress id="profile-step-progress" value="{{ selected_profile_run and selected_profile_run.state == 'done' ? 100 : 0 }}" max="100"></progress>
    </div>
    {% if selected_profile_run %}
      <div id="profile-canonical-results">
        {% if profile_items_view.status in ['ready','historical','pending'] %}
        <table class="prof-tbl">
          <thead><tr><th>Dimension</th><th>Résultat LAB</th><th>Détail</th></tr></thead>
          <tbody>
          {% for row in profile_items_view.rows %}
            <tr><td><strong>{{ row.label|trans({}, 'ezs_profile_items', ezs_pipeline_locale) }}</strong></td><td>{% for line in row.lines %}<div>{% for part in line %}{% if part.translate %}{{ part.text|trans({}, 'ezs_profile_items', ezs_pipeline_locale) }}{% elseif part.taxonomy|default(false) and ezs_pipeline_locale|slice(0,2) == 'fr' %}{% set term = 'taxonomy_' ~ part.text %}{% set translated = term|trans({}, 'ezs_profile_items', ezs_pipeline_locale) %}{{ translated == term ? part.text : translated }}{% else %}{{ part.text }}{% endif %}{% if not loop.last %}{{ row.label == 'item_5' ? ' ' : (row.label == 'item_6' ? ' / ' : ' · ') }}{% endif %}{% endfor %}</div>{% endfor %}</td><td class="meta">{{ row.detail|trans({}, 'ezs_profile_items', ezs_pipeline_locale) }}</td></tr>
          {% else %}
            {% for item_id in ['1','1a','1b','1c','2','3','4','5','6','7','8','9'] %}
              <tr><td><strong>{{ ('item_' ~ item_id)|trans({}, 'ezs_profile_items', ezs_pipeline_locale) }}</strong></td><td>—</td><td class="meta">{{ 'state_not_analyzed'|trans({}, 'ezs_profile_items', ezs_pipeline_locale) }}</td></tr>
            {% endfor %}
          {% endfor %}
          </tbody>
        </table>
      {% elseif profile_items_view.status == 'error' %}
        <p class="meta" role="alert">{{ 'contract_error'|trans({}, 'ezs_profile_items', ezs_pipeline_locale) }}</p>
      {% endif %}
      </div>
      {% if profile_items_view.status in ['historical','pending'] %}
        <details id="profile-legacy-results" style="margin-top:24px">
          <summary style="cursor:pointer;font-size:11px;font-weight:600">{{ ('legacy_' ~ profile_items_view.status)|trans({}, 'ezs_profile_items', ezs_pipeline_locale) }}</summary>
      {% set p = selected_profile_run.metrics %}{% set pv = selected_profile_run.diagnostics.profile_view ?? {} %}{% set vox = pv.vocal_profile.dimensions ?? {} %}
      <table class="prof-tbl">
        <thead><tr><th>Dimension</th><th>Résultat LAB</th><th>Détail</th></tr></thead>
        <tbody>
          <tr><td><strong>Durée</strong></td><td>{% if p.duration_seconds is defined %}{{ (p.duration_seconds / 60)|round(0, 'floor') }}:{{ '%02d'|format((p.duration_seconds % 60)|round(0, 'floor')) }}{% else %}—{% endif %}</td><td class="meta">{% if p.duration_seconds is defined %}{{ p.duration_seconds|number_format(2) }} s{% endif %}</td></tr>
          <tr><td><strong>Tempo</strong></td><td>{% if p.tempo.bpm is defined %}{{ p.tempo.bpm|number_format(2) }} BPM{% else %}—{% endif %}</td><td class="meta">{% if p.tempo.confidence is defined %}{{ (p.tempo.confidence * 100)|number_format(0) }}%{% endif %}</td></tr>
          <tr><td><strong>Mesure</strong></td><td>{{ p.time_signature.label ?? p.time_signature.suggested_label ?? '—' }}</td><td class="meta">{% if p.time_signature.confidence is defined %}{{ (p.time_signature.confidence * 100)|number_format(0) }}%{% endif %}</td></tr>
          <tr><td><strong>Tonalité</strong></td><td>{{ pv.tonal.label ?? p.key.label ?? '—' }}</td><td class="meta">{% if p.key.confidence is defined %}{{ (p.key.confidence * 100)|number_format(0) }}%{% endif %}</td></tr>
          <tr><td><strong>Genre</strong></td><td>{{ pv.genre_hierarchy.primary.genre ?? '—' }}</td><td class="meta">{% if profile_summary and profile_summary.genres %}{% for x in profile_summary.genres|slice(0,3) %}{{ x.label }} ({{ (x.score*100)|number_format(0) }}%){% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</td></tr>
          {% set insts = pv.instrumentation.candidates ?? [] %}
          {% for inst in insts %}
            <tr><td><strong>Instrument {{ loop.index }}</strong></td><td>{{ inst.label }}</td><td class="meta">{% if inst.score is defined and inst.score is not null %}{{ (inst.score * 100)|number_format(0) }}%{% else %}CLAP / AudioSet{% endif %}</td></tr>
          {% else %}
            <tr><td><strong>Instruments</strong></td><td>—</td><td class="meta">Aucun</td></tr>
          {% endfor %}
          <tr><td><strong>Voix principale</strong></td><td>{{ vox.lead_vocal.decision ?? '—' }}</td><td class="meta">lead_vocal</td></tr>
          <tr><td><strong>Voix accomp.</strong></td><td>{{ vox.backing_vocals.decision ?? '—' }}</td><td class="meta">backing_vocals</td></tr>
          <tr><td><strong>Harmonies</strong></td><td>{{ vox.vocal_harmonies.decision ?? '—' }}</td><td class="meta">vocal_harmonies</td></tr>
          <tr><td><strong>Chœur</strong></td><td>{{ vox.choir.decision ?? '—' }}</td><td class="meta">choir</td></tr>
        </tbody>
      </table>
        </details>
      {% endif %}
      {% set completed_modules = selected_profile_run.diagnostics.module_registry.modules ?? [] %}
      {% if completed_modules is not empty or selected_song %}
        <details class="ezs-tech-pipeline" id="profile-modules-details" style="margin-top:24px"><summary id="profile-modules-summary" style="cursor:pointer;font-size:11px;font-weight:600">Logique : Pipeline des {{ completed_modules|length }} moteurs · run #{{ selected_profile_run.id }}</summary>
          <table class="prof-tbl" data-ezs-observability="r2" style="margin-top:4px">{{ ezs_pipeline.header(ezs_pipeline_locale) }}<tbody id="profile-module-rows">
            <tr id="profile-live-pipeline-row" hidden><td colspan="6" id="profile-live-pipeline" class="meta" role="status" aria-live="polite"></td></tr>
            {% for m in completed_modules %}
              {% set ezs_lab_raw = m.display_name ?? m.name ?? m.module_id ?? m.id ?? '' %}
              {% set ezs_lab_name = ezs_lab_raw|replace({'_':' '}) %}
              {% set ezs_lab_code = ezs_lab_raw|lower %}
              {% set ezs_lab_step_id = 'processing' %}
              {% if 'tonal' in ezs_lab_code or 'key' in ezs_lab_code %}
                {% set ezs_lab_step_id = 'tonality' %}
              {% elseif 'beat' in ezs_lab_code or 'rhythm' in ezs_lab_code %}
                {% set ezs_lab_step_id = 'rhythm' %}
              {% elseif 'meter' in ezs_lab_code %}
                {% set ezs_lab_step_id = 'meter' %}
              {% elseif 'tuning' in ezs_lab_code %}
                {% set ezs_lab_step_id = 'tuning' %}
              {% elseif 'clap' in ezs_lab_code or 'passt' in ezs_lab_code or 'panns' in ezs_lab_code %}
                {% set ezs_lab_step_id = 'semantic' %}
              {% elseif 'mert' in ezs_lab_code or 'embedding' in ezs_lab_code %}
                {% set ezs_lab_step_id = 'embedding' %}
              {% elseif 'descriptor' in ezs_lab_code %}
                {% set ezs_lab_step_id = 'descriptors' %}
              {% endif %}
              {% set ezs_lab_step_name = ('ezs.profile.step.' ~ ezs_lab_step_id)|trans({}, 'ezs_profile', ezs_pipeline_locale) %}
              {% set ezs_lab_status = (m.status ?? '')|lower %}
              {% set ezs_lab_status_key = ezs_lab_status in ['ok','completed','degraded','error','failed','skipped','running','pending','blocked'] ? 'ezs.profile.status.' ~ ezs_lab_status : 'ezs.profile.status.unknown' %}
              {{ ezs_pipeline.row(loop.index, (m.step_label ?? m.phase_label ?? ezs_lab_step_name), ezs_lab_name, (m.device ?? null) ?: (ezs_pipeline_locale|slice(0,2) == 'fr' ? 'Non renseigné' : 'Not reported'), ezs_lab_status_key|trans({}, 'ezs_profile', ezs_pipeline_locale), m.timing.elapsed_seconds ?? null, ezs_lab_raw) }}
            {% endfor %}
          </tbody></table>
        </details>
      {% endif %}
    {% else %}
      <details class="ezs-tech-pipeline" id="profile-modules-details" style="margin-top:24px" open>
        <summary id="profile-modules-summary">Logique : Pipeline PROFILE · en attente</summary>
        <table class="prof-tbl">{{ ezs_pipeline.header(ezs_pipeline_locale) }}
          <tbody id="profile-module-rows"><tr><td colspan="6">{{ 'ezs.profile.table.lab_pending'|trans({}, 'ezs_profile', ezs_pipeline_locale) }}</td></tr></tbody>
        </table>
      </details>
    {% endif %}
  </section>
  <div id="profile-expertise-column">
    <section class="card" id="profile-expertise-table">
      <div class="prof-bar">
        <div><span class="badge">3 · Expertise</span> <h2 style="display:inline-block;margin-left:6px">Résultats &amp; Sources</h2></div>
    <div class="prof-actions">
      {% if selected_song and selected_profile_run and selected_profile_run.state == 'done' %}
        <button type="button" data-profile-chatgpt="{{ path('profile_expertise_chatgpt') }}" data-song="{{ selected_song.id }}" data-run="{{ selected_profile_run.id }}">Expertiser</button>

        <script src="/js/ezs-profile-chatgpt.js?v=fifo-r1" defer></script>
      {% endif %}
      {% if selected_song %}{% include 'workbench/_expertise_action.html.twig' with {expertise_export_url: path('profile_expertise_export', {song: selected_song.id, run: selected_profile_run.id ?? null}|filter(v => v is not null)), expertise_label: 'Bridge Brave', expertise_mode: 'individual'} only %}{% endif %}
        {% if selected_song and selected_profile_run and selected_profile_run.state == 'done' %}
        <select id="profile-chatgpt-revision" aria-label="Rapport d’expertise" style="font-size:11px" disabled>
          <option value="">Aucune expertise</option>
        </select>
        {% endif %}

    </div>
      </div>
    {% if selected_song and selected_profile_run and selected_profile_run.state == 'done' %}
      <div id="profile-chatgpt-progress" class="prof-prog-box" aria-label="Progression de l'expertise ChatGPT">
        <div class="row" style="justify-content:space-between;font-size:11px">
          <span class="meta" id="profile-chatgpt-status" role="status" aria-live="polite">Prêt</span>
          <ol class="profile-expertise-steps" aria-label="Étapes de l'expertise">
            <li>Préparation</li><li>Connexion</li><li>Recherche</li>
          </ol>
        </div>
        <progress max="3" value="0" aria-label="Étapes d'expertise terminées"></progress>
      </div>
    {% endif %}
      <div data-expertise-spacer aria-hidden="true"></div>
      {% if profile_items_view.status in ['ready','historical','pending'] %}
      <table class="prof-tbl">
        <thead><tr><th>Dimension</th><th>Verdict et justification</th><th>Sources</th></tr></thead>
        <tbody>
        {% set dimensions = profile_items_view.rows ? profile_items_view.rows|map(row => row.label) : ['item_1','item_1a','item_1b','item_1c','item_2','item_3','item_4','item_5','item_6','item_7','item_8','item_9'] %}
        {% for dimension in dimensions %}
          <tr data-expertise-item="{{ dimension|slice(5) }}">
            <td><strong>{{ dimension|trans({}, 'ezs_profile_items', ezs_pipeline_locale) }}</strong></td>
            <td data-verdict class="meta">En attente</td><td data-sources class="meta">—</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% endif %}
    </section>
    {% if selected_song and selected_profile_run and selected_profile_run.state == 'done' %}
      <section class="card" id="profile-chatgpt-result">
        <div class="prof-bar">
          <label for="profile-chatgpt-jsonl"><strong>Fiche JSONL</strong> <span class="meta" data-report-label></span></label>
          <button type="button" class="secondary" data-copy-jsonl disabled>Copier le JSONL</button>
        </div>
        <textarea id="profile-chatgpt-jsonl" data-report-text readonly rows="5" wrap="off"
          placeholder="Le JSONL apparaîtra ici après l'expertise."
          style="width:100%;box-sizing:border-box;resize:vertical"></textarea>
        <span class="meta" data-copy-status role="status"></span>
        <ul data-report-sources style="overflow-wrap:anywhere" hidden></ul>
      </section>
    {% endif %}
    {% include 'workbench/_expertise_prompt.html.twig' %}
  </div>
  <style>
.v-badge-tip{position:relative;display:inline-block;cursor:help}
.v-badge-tip .v-badge-pop{display:none;position:absolute;left:50%;bottom:calc(100% + 6px);transform:translateX(-50%);width:290px;padding:8px 10px;border-radius:6px;background:#0f172a;color:#e2e8f0;border:1px solid #334155;box-shadow:0 8px 20px rgba(0,0,0,.5);font-size:11px;font-weight:400;line-height:1.4;text-transform:none;letter-spacing:normal;text-align:left;z-index:60;white-space:normal}
.v-badge-tip:hover .v-badge-pop,.v-badge-tip:focus .v-badge-pop{display:block}
</style>
<style>
.prof-tbl th,.prof-tbl td{height:36px;padding-top:4px;padding-bottom:4px;vertical-align:middle;white-space:nowrap}
.prof-tbl .ana-cell{max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
</style>

</div>

<div class="card" style="margin-top:8px;position:relative">
  <div style="position:absolute;top:11px;left:295px;display:inline-flex;align-items:center;gap:8px;z-index:2">
    <button type="button" id="copy-diag-btn" class="secondary" style="padding:2px 10px;font-size:11px">Copier &amp; Exporter .json</button>
    <span id="copy-diag-status" style="display:none;font-size:11px;font-weight:600;color:#4ade80">✓ Copié</span>
  </div>
  <details><summary style="cursor:pointer;font-size:12px;font-weight:600;line-height:22px">4 · Diagnostic PROFILE (dump Twig brut)</summary>
    <pre id="diag-json-pre" style="font-size:11px;max-height:360px;overflow:auto;margin-top:8px">{{ {'selected_song': selected_song, 'selected_profile_run': selected_profile_run ? {'id': selected_profile_run.id, 'public_id': selected_profile_run.public_id, 'state': selected_profile_run.state, 'engine_name': selected_profile_run.engine_name, 'engine_version': selected_profile_run.engine_version} : null, 'profile_summary': profile_summary}|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
  </details>
</div>
<script>
document.getElementById('copy-diag-btn')?.addEventListener('click', async function() {
  const pre = document.getElementById('diag-json-pre');
  if (!pre) return;
  const txt = pre.textContent || '';
  try {
    if (navigator.clipboard && window.isSecureContext) { await navigator.clipboard.writeText(txt); }
    else { throw new Error('fallback'); }
  } catch (_) {
    const ta = document.createElement('textarea');
    ta.value = txt; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
  }
  const blob = new Blob([txt], { type: 'application/json;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'diagnostic-profile-dump.json';
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
  const st = document.getElementById('copy-diag-status');
  if (st) { st.textContent = '✓ Copié + .json'; }
  if (st) { st.style.display = 'inline'; setTimeout(() => { st.style.display = 'none'; }, 2000); }
});
</script>
<script>
(function(){
  const ezsPipelineStatus = {
    ok: {{ ('ezs.profile.status.ok'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
    completed: {{ ('ezs.profile.status.completed'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
    degraded: {{ ('ezs.profile.status.degraded'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
    error: {{ ('ezs.profile.status.error'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
    failed: {{ ('ezs.profile.status.failed'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
    blocked: {{ ('ezs.profile.status.blocked'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
    skipped: {{ ('ezs.profile.status.skipped'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
    running: {{ ('ezs.profile.status.running'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
    pending: {{ ('ezs.profile.status.pending'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
    unknown: {{ ('ezs.profile.status.unknown'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }}
  };
  function ezsPipelineLabel(value){ return String(value || '—').replace(/_/g,' ').replace(/\s+/g,' ').trim(); }
  function ezsPipelineAppendRow(tbody, index, stepName, moduleName, device, status, seconds){
    const row=document.createElement('tr');
    const values=[String(index),ezsPipelineLabel(stepName),ezsPipelineLabel(moduleName),String(device||{{ (ezs_pipeline_locale|slice(0,2) == 'fr' ? 'Non renseigné' : 'Not reported')|json_encode|raw }}),String(status||ezsPipelineStatus.unknown),
      Number.isFinite(seconds)?seconds.toFixed(2)+'s':'—'];
    for(const value of values){const td=document.createElement('td');td.textContent=value;row.appendChild(td);}
    tbody.appendChild(row);
  }
  const ezsLabStepLabels = {
      tonality: {{ ('ezs.profile.step.tonality'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
      rhythm: {{ ('ezs.profile.step.rhythm'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
      meter: {{ ('ezs.profile.step.meter'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
      tuning: {{ ('ezs.profile.step.tuning'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
      semantic: {{ ('ezs.profile.step.semantic'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
      embedding: {{ ('ezs.profile.step.embedding'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
      descriptors: {{ ('ezs.profile.step.descriptors'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }},
      processing: {{ ('ezs.profile.step.processing'|trans({}, 'ezs_profile', ezs_pipeline_locale))|json_encode|raw }}
    };
    function ezsLabStepName(m){
      const n=String(m?.display_name||m?.name||m?.module_id||m?.id||'').toLowerCase();
      const key=/tonal|key/.test(n)?'tonality':/beat|rhythm/.test(n)?'rhythm':/meter/.test(n)?'meter':/tuning/.test(n)?'tuning':/clap|passt|panns/.test(n)?'semantic':/mert|embedding/.test(n)?'embedding':/descriptor/.test(n)?'descriptors':'processing';
      return ezsLabStepLabels[key];
    }
  // Suivi temps reel de la barre de progression Analyse LAB (profile_oneshot_status)
  const labUrl = {{ selected_song ? path('profile_oneshot_status', {id: selected_song.id})|json_encode|raw : '""' }};
  const labCancelPattern = {{ path('profile_once_cancel', {id: 999999999})|json_encode|raw }};
  const labState = document.getElementById('profile-step-state');
  const labProg = document.getElementById('profile-step-progress');
  const labCur = document.getElementById('profile-step-current');
  const labCancel = document.getElementById('profile-live-cancel');
  let labJobId = 0, labWasActive = false;
  const livePipeline = document.getElementById('profile-live-pipeline');
  const liveModuleBody = document.getElementById('profile-module-rows');
  const liveModuleDetails = document.getElementById('profile-modules-details');
  const liveModuleSummary = document.getElementById('profile-modules-summary');
  let liveModuleJob = 0;
  function renderLiveModules(d) {
    if (!liveModuleBody || !liveModuleDetails) return;
    const job=Number(d.job_id||0), run=Number(d.run_id||0);
    if (!job || !run || !Array.isArray(d.modules)) return;
    // Ignore a delayed polling response from an earlier job.
    if (liveModuleJob>0 && job<liveModuleJob) return;
    if (liveModuleJob !== job) liveModuleJob=job;
    liveModuleDetails.open=true;
    if (liveModuleSummary) liveModuleSummary.textContent='Logique : Pipeline PROFILE · run #'+run+' · job LAB #'+job;
    liveModuleBody.replaceChildren();
    const modules = d.modules;
    if (!modules.length) {
      const tr=document.createElement('tr'),td=document.createElement('td');td.colSpan=6;
      td.textContent='Préparation du pipeline : aucune fin de moteur attestée.';
      tr.appendChild(td);liveModuleBody.appendChild(tr);
      return;
    }
    for (const [index,m] of modules.entries()) {
      const status=ezsPipelineStatus[String(m.status||'').toLowerCase()]||ezsPipelineStatus.unknown;
      const observed=['ok','completed','error','failed','skipped'].includes(m.status);
      ezsPipelineAppendRow(liveModuleBody,index+1,m.step_label||m.phase_label||ezsLabStepName(m),m.name||m.module_id||m.id,
        observed?m.device:null,status,observed&&typeof m.elapsed_seconds==='number'?m.elapsed_seconds:null);
    }
  }
  const selectedScientificRun = {{ selected_profile_run ? selected_profile_run.id : 0 }};

  async function pollLab() {
    if (!labUrl || !labState || !labProg) return;
    try {
      const r = await fetch(labUrl, {credentials: 'same-origin', cache: 'no-store'});
      if (!r.ok) return;
      const d = await r.json();
      if (!d.available) return;
      labJobId = Number(d.job_id || 0);
      const active = ['queued', 'running', 'cancelling'].includes(d.job_status) && ['queued', 'running', 'created'].includes(d.state);
      if (active) {
        renderLiveModules(d);
      }
      if(livePipeline){
        livePipeline.closest("tr").hidden=true;
        const scientificId=Number(d.run_id||0);
        const stage=typeof d.stage==='string' ? d.stage.slice(0,140) : '';
        livePipeline.textContent=active
          ? ('Observation en direct · job LAB #'+labJobId+' · run #'+scientificId+(selectedScientificRun>0 && scientificId!==selectedScientificRun?' · attention : la projection historique affichée concerne le run #'+selectedScientificRun:'')+' · '+(stage||'moteur en cours non communiqué')+' · fin individuelle des moteurs non attestée par l’API')
          : ('Dernier job LAB #'+labJobId+' : '+String(d.job_status||d.state||'état inconnu')+' · vue historique séparée');
      }
      labState.dataset.ezsJobState = d.job_status || d.state;
      labProg.dataset.ezsJobState = d.job_status || d.state;
      if (active) labWasActive = true;
      const pct = Math.max(0, Math.min(100, Number(d.progress) || 0));
      labProg.value = active ? pct : ({{ selected_profile_run and selected_profile_run.state == 'done' ? 100 : 0 }});
      if (active) {
        labState.textContent = 'Job #' + labJobId + ' · ' + d.job_status + ' (' + pct + '%)';
        if (labCur) labCur.textContent = d.stage || '';
      }
      if (labCancel) {
        labCancel.disabled = !active || d.job_status === 'cancelling';
      }
      if (labWasActive && !active && d.job_status === 'completed' && d.state === 'done') {
        labWasActive = false;
        const url=new URL(window.location.href);
        url.searchParams.set('run',String(d.run_id));
        window.location.assign(url.toString());
      }
    } catch (_) {}
  }
  labCancel?.addEventListener('click', async () => {
    if (!labJobId) return;
    labCancel.disabled = true;
    await fetch(labCancelPattern.replace('999999999', String(labJobId)), {method: 'POST', credentials: 'same-origin', headers: {'X-EZS-Profile-Cancel': 'request'}});
    pollLab();
  });
  pollLab();
  setInterval(pollLab, 2000);

})();
</script>
{% endif %}
</div>
{% endblock %}
