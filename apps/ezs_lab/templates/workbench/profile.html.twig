    for (const [index,m] of modules.entries()) {
      const status=ezsPipelineStatus[String(m.status||'').toLowerCase()]||ezsPipelineStatus.unknown;
      const observed=['ok','completed','error','failed','skipped'].includes(m.status);
      ezsPipelineAppendRow(liveModuleBody,index+1,m.step_label||m.phase_label||ezsLabStepName(m),m.name||m.module_id||m.id,
        observed?m.device:null,status,observed&&typeof m.elapsed_seconds==='number'?m.elapsed_seconds:null);
    }
  }
  const selectedScientificRun = {{ selected_profile_run ? selected_profile_run.id : 0 }};

  async function pollLab() {
    if (!labUrl || !labState || !labProg) return;
    try {
      const r = await fetch(labUrl, {credentials: 'same-origin', cache: 'no-store'});
      if (!r.ok) return;
      const d = await r.json();
      if (!d.available) return;
      labJobId = Number(d.job_id || 0);
      const active = ['queued', 'running', 'cancelling'].includes(d.job_status) && ['queued', 'running', 'created'].includes(d.state);
      if (active) {
        renderLiveModules(d);
      }
      if(livePipeline){
        livePipeline.closest("tr").hidden=true;
        const scientificId=Number(d.run_id||0);
        const stage=typeof d.stage==='string' ? d.stage.slice(0,140) : '';
        livePipeline.textContent=active
          ? ('Observation en direct · job LAB #'+labJobId+' · run #'+scientificId+(selectedScientificRun>0 && scientificId!==selectedScientificRun?' · attention : la projection historique affichée concerne le run #'+selectedScientificRun:'')+' · '+(stage||'moteur en cours non communiqué')+' · fin individuelle des moteurs non attestée par l’API')
          : ('Dernier job LAB #'+labJobId+' : '+String(d.job_status||d.state||'état inconnu')+' · vue historique séparée');
      }
      if (active) labWasActive = true;
      const pct = Math.max(0, Math.min(100, Number(d.progress) || 0));
      labProg.value = active ? pct : ({{ selected_profile_run and selected_profile_run.state == 'done' ? 100 : 0 }});
      if (active) {
        labState.textContent = 'Job #' + labJobId + ' · ' + d.job_status + ' (' + pct + '%)';
        if (labCur) labCur.textContent = d.stage || '';
      }
      if (labCancel) {
        labCancel.disabled = !active || d.job_status === 'cancelling';
      }
      if (labWasActive && !active && d.job_status === 'completed' && d.state === 'done') {
        labWasActive = false;
        const url=new URL(window.location.href);
        url.searchParams.set('run',String(d.run_id));
        window.location.assign(url.toString());
      }
    } catch (_) {}
  }
  labCancel?.addEventListener('click', async () => {
    if (!labJobId) return;
    labCancel.disabled = true;
    await fetch(labCancelPattern.replace('999999999', String(labJobId)), {method: 'POST', credentials: 'same-origin', headers: {'X-EZS-Profile-Cancel': 'request'}});
    pollLab();
  });
  pollLab();
  setInterval(pollLab, 2000);

})();
</script>
{% endif %}
</div>
{% endblock %}
