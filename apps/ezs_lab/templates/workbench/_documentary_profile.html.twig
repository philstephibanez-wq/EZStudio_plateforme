{# Documentary R7/R8 evidence is displayed without calling the LAB verifier. #}
{% macro value(item, value) %}
  {%- if item == 'duration' and value matches '/^[0-9]+([.][0-9]+)?$/' -%}
    {{ (value / 60)|round(0,'floor') }}:{{ '%02d'|format((value % 60)|round(0,'floor')) }} ({{ value }} s)
  {%- elseif item == 'tempo' -%}{{ value }} BPM
  {%- elseif item in ['lead_vocal','backing_vocals','vocal_harmonies','choir'] -%}
    {{ value == 'present' ? 'Présent' : (value == 'absent' ? 'Absent (déclaration explicite)' : value) }}
  {%- else -%}{{ value }}{%- endif -%}
{% endmacro %}
{% import _self as doc_fmt %}
{% set doc_labels = {'duration':'Durée','tempo':'Tempo','meter':'Mesure','key':'Tonalité','genre':'Genre','instrument':'Instrumentation','lead_vocal':'Voix principale','backing_vocals':'Voix accomp.','vocal_harmonies':'Harmonies vocales','choir':'Chœur','year':'Année'} %}
{% set doc_items = doc_profile.provisional.items ?? {} %}
{% set evidence_count = 0 %}
{% for key, label in doc_labels %}
  {% if (doc_items[key].evidence ?? []) is not empty %}{% set evidence_count = evidence_count + 1 %}{% endif %}
{% endfor %}
<div class="prof-prog-box" style="font-size:11px;gap:4px">
  <strong>Recherche documentaire autonome — {{ evidence_count }}/11 items renseignés</strong>
  <span>Identité exacte de l'enregistrement et indépendance éditoriale non certifiées. Comparaison LAB désactivée.</span>
  {% if evidence_count == 0 %}<span class="meta">Aucune preuve documentaire retenue ; les erreurs et tentatives sont détaillées ci-dessous.</span>{% endif %}
  <span class="meta">{{ doc_profile.schema ?? 'Profil documentaire' }} · résultat documentaire non qualifié</span>
</div>
<table class="prof-tbl" data-ezs-documentary="r8">
  <thead><tr><th>Item</th><th>Observations externes</th><th>Qualification</th><th>Preuves et recherche</th></tr></thead>
  <tbody>
  {% for key, label in doc_labels %}
    {% set item = doc_items[key] ?? {} %}
    {% set evidence = item.evidence ?? [] %}
    {% set candidates = item.candidates ?? [] %}
    {% set errors = item.errors ?? [] %}
    {% if item.errors is not defined %}
      {% for err in (doc_profile.errors ?? []) %}
        {% if (err.item ?? '') == key %}{% set errors = errors|merge([err]) %}{% endif %}
      {% endfor %}
    {% endif %}
    {% set doc_status = item.status ?? 'unknown' %}
    <tr>
      <td><strong>{{ label }}</strong></td>
      <td>
        {% if candidates is not empty %}
          {# Report each distinct observation, not an invented weighted mean. #}
          {% set shown = [] %}
          {% for candidate in candidates %}
            {% for observed in (candidate.observed ?? [candidate.value]) %}
              {% if observed not in shown %}
                <div>{{ doc_fmt.value(key, observed) }}</div>
                {% set shown = shown|merge([observed]) %}
              {% endif %}
            {% endfor %}
          {% endfor %}
        {% else %}—{% endif %}
      </td>
      <td style="font-size:11px">
        {% if doc_status == 'divergent' %}<strong>Divergences</strong>
        {% elseif candidates is not empty %}<strong>Provisoire</strong>
        {% elseif doc_status == 'search_incomplete' or errors is not empty %}<strong>Recherche incomplète</strong>
        {% else %}<strong>Inconnu</strong>{% endif %}
        <div class="meta">{{ item.eligible_domains ?? 0 }} famille(s) avec observation · 0/{{ item.target_sources ?? 5 }} sources certifiées</div>
        {% if doc_status == 'target_reached_uncertified' %}<div class="meta">Objectif de concordance atteint, indépendance non démontrée.</div>{% endif %}
        {% if candidates is not empty %}
          <div class="meta">Confiance : non qualifiée</div>
          <details><summary>Concordances</summary>
            {% for candidate in candidates %}
              <div>{% for v in (candidate.observed ?? [candidate.value]) %}{{ doc_fmt.value(key, v) }}{% if not loop.last %} / {% endif %}{% endfor %} · {{ candidate.support ?? 0 }} famille(s)</div>
              {% if (candidate.families ?? candidate.domains ?? []) is not empty %}<div class="meta">{{ (candidate.families ?? candidate.domains)|join(', ') }}</div>{% endif %}
            {% endfor %}
          </details>
        {% endif %}
        {% if item.duration_ms is defined %}<div class="meta">Recherche item : {{ (item.duration_ms / 1000)|number_format(2, ',', ' ') }} s</div>{% endif %}
      </td>
      <td style="font-size:11px;overflow-wrap:anywhere">
        {% if evidence is not empty %}
          <details>
            <summary>{{ evidence|length }} observation(s) documentée(s)</summary>
            {% for e in evidence %}
              <div style="margin:5px 0;padding:4px 0;border-bottom:1px solid var(--line)">
                {% if (e.url ?? '') starts with 'https://' %}<a href="{{ e.url }}" target="_blank" rel="noopener noreferrer">{{ e.family ?? e.domain ?? 'Source' }}</a>{% else %}Source non disponible{% endif %}
                · <strong>{{ doc_fmt.value(key, e.value) }}</strong>
                {% if e.field is defined %}<div class="meta">Champ JSON : {{ e.field }}</div>{% endif %}
                {% if e.quote is defined %}<div>« {{ e.quote }} »</div>{% endif %}
                {% if e.scope is defined %}<div class="meta">Portée : {{ e.scope }}</div>{% endif %}
              </div>
            {% endfor %}
          </details>
        {% endif %}
        <details>
          <summary>Requêtes, consultations et erreurs ({{ errors|length }})</summary>
          {% set queries = item.queries ?? [] %}
          {% if item.queries is not defined %}
            {% for q in (doc_profile.queries ?? []) %}{% if (q.item ?? '') == key %}{% set queries = queries|merge([q.query]) %}{% endif %}{% endfor %}
          {% endif %}
          {% for q in queries %}<div class="meta">{{ q }}</div>{% endfor %}
          {% for url in (item.consulted ?? []) %}{% if url starts with 'https://' %}<div><a href="{{ url }}" target="_blank" rel="noopener noreferrer">Document consulté</a> · {{ url }}</div>{% endif %}{% endfor %}
          {% for rejected in (item.rejected ?? []) %}<div class="meta">Rejet : {{ rejected.reason ?? 'non qualifié' }} · {{ rejected.url ?? '—' }}</div>{% endfor %}
          {% for error in errors %}<div class="meta">Erreur : {{ error.stage ?? 'recherche' }} / {{ error.type ?? 'inconnue' }}{% if error.reason is defined and error.reason %} · {{ error.reason }}{% endif %}{% if error.url is defined %} · {{ error.url }}{% endif %}</div>{% endfor %}
          {% for provider in (item.structured_providers ?? []) %}<div class="meta">{{ provider.provider }} : {{ provider.status }} ({{ provider.accepted }} candidat(s))</div>{% endfor %}
          {% if queries is empty and errors is empty %}<div class="meta">Aucune trace par item enregistrée.</div>{% endif %}
        </details>
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
<details style="margin-top:8px">
  <summary>Acquisition documentaire — {{ (doc_profile.documents ?? [])|length }} document(s) candidat(s)</summary>
  {% for provider in (doc_profile.provider_diagnostics ?? []) %}
    <div style="font-size:11px;margin:4px 0"><strong>{{ provider.provider }}</strong> · {{ provider.status }} · {{ provider.accepted }} candidat(s){% if provider.reason is defined %} · {{ provider.reason }}{% endif %}
      {% if (provider.url ?? '') starts with 'https://' %} · <a href="{{ provider.url }}" target="_blank" rel="noopener noreferrer">Requête publique</a>{% endif %}
      {% for rejection in (provider.rejected ?? []) %}<div class="meta">Rejet : {{ rejection.id ?? '—' }} · {{ rejection.reason }}</div>{% endfor %}
    </div>
  {% endfor %}
  {% for doc in (doc_profile.documents ?? []) %}
    {% if (doc.url ?? '') starts with 'https://' %}<div style="font-size:11px;margin:4px 0;overflow-wrap:anywhere"><a href="{{ doc.url }}" target="_blank" rel="noopener noreferrer">{{ doc.title ?: doc.url }}</a> · {{ (doc.facts ?? [])|length }} observation(s)</div>{% endif %}
  {% endfor %}
  <div class="meta" style="font-size:11px">Données musicales : <a href="https://getsongbpm.com/" target="_blank" rel="noopener noreferrer">GetSongBPM</a> lorsque configuré.</div>
</details>
