{% extends 'base.html.twig' %}
{% block title %}Catalogue · EZStudio_lab{% endblock %}
{% block body %}
<div class="card hero">
  <div>
    <h1>Catalogue</h1>
    <div class="meta">Chaîne d’analyse : PROFILE → STEMS → CHORDS/N → LYRICS.</div>
  </div>
  <a class="button" href="{{ path('workbench_import') }}">Importer une chanson</a>
</div>

{% if app.request.query.get('profile_all_queued') is not null %}
<div class="card">
  <strong>Tout analyser</strong> —
  {{ app.request.query.get('profile_all_queued') }} job(s) ajouté(s),
  {{ app.request.query.get('profile_all_skipped_active')|default(0) }} déjà actif(s),
  {{ app.request.query.get('profile_all_skipped_source')|default(0) }} sans source disponible.
</div>
{% endif %}

<style>
.catalog-actions{display:flex;align-items:center;gap:6px;flex-wrap:nowrap}
.catalog-phase-action{display:inline-flex;align-items:center;gap:2px}
.catalog-trash{padding:.42rem .5rem;min-width:2rem}
.catalog-zip-disabled{opacity:.45;pointer-events:none}
.catalog-job-cancel{margin-left:6px;padding:.2rem .45rem;font-size:11px}
</style>

<div class="catalog-batch-toolbar">
  <button type="button" class="secondary" data-profile-expertise-all="{{ path('profile_expertise_chatgpt') }}">Expertiser TOUT PROFILE</button>
  <span id="profile-expertise-all-status" class="meta" role="status"></span>
  <script src="/js/ezs-profile-expertise-all.js?v=1" defer></script>
  <form method="post"
        action="{{ path('profile_analyze_all') }}"
        class="catalog-profile-all-form"
        data-confirm="Lancer une nouvelle analyse PROFILE sur toutes les chansons du catalogue ? Les jobs PROFILE déjà actifs seront ignorés."
        style="display:inline">
    <button type="submit" class="secondary">Tout analyser</button>
  </form>
</div>

<div class="card" id="catalog-live-phase">
<table>
<thead>
<tr>
  <th>Chanson</th>
  <th>PROFILE</th>
  <th>STEMS</th>
  <th>CHORDS</th>
  <th>LYRICS</th>
  <th>Actions</th>
</tr>
</thead>
<tbody>
{% for song in songs %}
<tr>
  <td>
    <strong>{{ song.title }}</strong>
    {% if song.artist %}<div class="meta">{{ song.artist }}</div>{% endif %}
    <div class="meta">{{ song.source_filename }}</div>
  </td>

  {% for key in ['profile','stems','chords','lyrics'] %}
    {% set available = attribute(song, key) %}
    {% set attempt = available.latest_attempt|default(null) %}
    {# A completed PROFILE is the catalogue result; only an active attempt may supersede its badge. #}
    {% set active_attempt = attempt and attempt.state in ['queued','running','cancelling'] %}
    {% set s = key == 'profile' and attempt and attempt.state != 'legacy_fifo' and (active_attempt or available.state != 'done') ? attempt : available %}
    <td>
      {% if s.job_status == 'cancelling' or s.state == 'cancelling' %}
        <span class="ezs-badge ezs-badge--state-cancelling" data-analysis-active="1">{{ key == 'profile' ? 'Analyse : annulation en cours' : 'Annulation en cours' }}</span>
      {% elseif s.state == 'done' %}
        <span class="ezs-badge ezs-badge--state-ok">{{ key == 'profile' ? 'Analyse : prête' : 'Prêt' }}{% if s.version %} · <span class="catalog-version">{{ s.version|replace({'PROFILE.':'','STEMS.':'','CHORDS.':'','LYRICS.':''}) }}</span>{% endif %}</span>
      {% elseif key == 'profile' and s.state == 'legacy_fifo' %}
        <span class="badge">Ancienne tentative FIFO (historique)</span>
      {% elseif s.state == 'queued' %}
        <span class="ezs-badge ezs-badge--state-waiting" data-analysis-active="1">{{ key == 'profile' ? 'Analyse : en attente' : 'En attente' }}</span>
      {% elseif s.state == 'running' %}
        <span class="ezs-badge ezs-badge--state-progressing" data-analysis-active="1">{{ key == 'profile' ? 'Analyse : en cours' : 'En cours' }}</span>
      {% elseif s.state == 'cancelled' or s.job_status == 'cancelled' %}
        {% if key == 'profile' %}<span class="badge">—</span>{% else %}<span class="ezs-badge ezs-badge--state-cancelled">Annulé</span>{% endif %}
      {% elseif s.state == 'error' %}
        <span class="ezs-badge ezs-badge--state-ko">Erreur</span>
      {% elseif s.state == 'configured' %}
        <span class="badge">Configuré</span>
      {% else %}
        <span class="badge">—</span>
      {% endif %}
      {% if key == 'profile' and available.state == 'done' and s.run_id != available.run_id %}<div class="meta">Analyse précédente prête{% if available.version %} · {{ available.version|replace({'PROFILE.':''}) }}{% endif %}</div>{% endif %}
    </td>
  {% endfor %}

  <td>
    <div class="catalog-actions">
      {% set actions = [
        {key:'profile', label:'PROFILE', route:'workbench_profile', cascade:'PROFILE + STEMS + CHORDS/N + LYRICS'},
        {key:'stems', label:'STEMS', route:'workbench_stems', cascade:'STEMS + CHORDS/N + LYRICS'},
        {key:'chords', label:'CHORDS', route:'lab_chords_experiment', cascade:'CHORDS/N + LYRICS'},
        {key:'lyrics', label:'LYRICS', route:'workbench_lyrics', cascade:'LYRICS'}
      ] %}
      {% for action in actions %}
        {% set state = attribute(song, action.key) %}
        <span class="catalog-phase-action">
          <a class="button secondary{{ state.state == 'done' ? ' catalog-phase-ready' : '' }}" href="{{ path(action.route,{song:song.id}) }}">{{ action.label }}</a>
          {% if state.state != 'none' %}
          <form method="post"
                action="{{ path('catalog_phase_delete',{id:song.id,phase:action.key}) }}"
                class="catalog-delete-form"
                data-confirm="Abandonner {{ action.cascade }} pour « {{ song.title|e('html_attr') }} » ? Les Presets et l’historique seront conservés."
                style="display:inline">
            <button type="submit"
                    class="secondary catalog-trash catalog-delete-button"
                    title="Abandonner {{ action.cascade }} sans détruire les Presets"
                    aria-label="Abandonner {{ action.cascade }}">🗑</button>
          </form>
          {% endif %}
        </span>
      {% endfor %}

      {% set analysis_chain_present =
        song.profile.state != 'none'
        or song.stems.state != 'none'
        or song.chords.state != 'none'
        or song.lyrics.state != 'none'
      %}
      {% if analysis_chain_present %}
        <a class="button secondary"
           href="{{ path('preset_export_zip',{id:song.id}) }}"
           title="Exporter les Presets disponibles">Exporter les Presets</a>
      {% else %}
        <span class="button secondary catalog-zip-disabled" title="Aucun Preset disponible">Exporter les Presets</span>
      {% endif %}

      <form method="post"
            action="{{ path('catalog_delete',{id:song.id}) }}"
            class="catalog-delete-form"
            data-confirm="Supprimer définitivement « {{ song.title|e('html_attr') }} », sa chaîne d’analyse complète et sa source ?"
            style="display:inline">
        <button type="submit"
                class="secondary catalog-trash catalog-delete-button"
                title="Purge définitive de la chanson entière"
                aria-label="Supprimer {{ song.title }}">🗑</button>
      </form>
    </div>
  </td>
</tr>
{% else %}
<tr>
  <td colspan="6">
    Aucune chanson dans le catalogue.
    <a href="{{ path('workbench_import') }}">Importer une chanson</a>
  </td>
</tr>
{% endfor %}
</tbody>
</table>
</div>

<script>
/* EZS_R1H_CATALOGUE_LIVE — read-only refresh, no server-side job mutations. */
(function () {
  let pending = false;
  window.setInterval(async function () {
    if (pending || document.visibilityState !== 'visible') return;
    pending = true;
    try {
      const response = await fetch(window.location.href, {cache:'no-store', credentials:'same-origin'});
      if (!response.ok) return;
      const page = new DOMParser().parseFromString(await response.text(), 'text/html');
      const old = document.getElementById('catalog-live-phase');
      const next = page.getElementById('catalog-live-phase');
      if (old && next) old.replaceWith(document.importNode(next, true));
    } catch (_) { /* Keep last known state; never invent job progress. */ }
    finally { pending = false; }
  }, 4000);
}());
</script>
{% endblock %}
