  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "importance": {
          "enum": [
            "identification",
            "non_determining",
            "determining",
            "useful_non_determining"
          ]
        },
        "domain": {
          "enum": [
            "documentary",
            "scientific"
          ]
        },
        "existing_source": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "comparison": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "tolerance": {}
          },
          "required": [
            "mode",
            "tolerance"
          ],
          "additionalProperties": false
        },
        "potential_consumers": {
          "type": "array",
          "items": {
            "enum": [
              "stems",
              "chords",
              "lyrics"
            ]
          },
          "uniqueItems": true
        },
        "producer_module_candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "producer_status": {
          "enum": [
            "existing_evidence_only",
            "non_module_source_or_unavailable",
            "candidate_not_qualified"
          ]
        }
      },
      "required": [
        "id",
        "key",
        "label",
        "importance",
        "domain",
        "existing_source",
        "logical_type",
        "comparison",
        "potential_consumers",
        "producer_module_candidates",
        "producer_status"
      ],
      "additionalProperties": false
    }
  }
