{
  "schema": "ezs.assistant.expertise-preset.v2",
  "id": "profile-expertise-baseline-v2",
  "phase": "profile",
  "pipeline": [
    "identity_resolver",
    "catalog_disambiguator",
    "web_collector",
    "ocr_reader",
    "evidence_extractor",
    "set_verdict_engine"
  ],
  "engines": {
    "identity_resolver": {
      "enabled": true,
      "provider": "local",
      "temperature": 0.1,
      "max_tokens": 256,
      "max_candidates": 3,
      "min_catalog_score": 90
    },
    "catalog_disambiguator": {
      "enabled": true,
      "providers": [
        "musicbrainz"
      ],
      "search_limit": 20,
      "duration_tolerance_ms": 2000,
      "min_margin_ms": 4000,
      "prefer_studio": true
    },
    "web_collector": {
      "enabled": true,
      "connectors": [
        "certified_catalog",
        "encyclopedia_api",
        "open_web"
      ],
      "max_results_per_query": 8,
      "max_docs_per_assertion": 5,
      "fetch_timeout_s": 14
    },
    "ocr_reader": {
      "enabled": true,
      "languages": [
        "eng",
        "fra"
      ],
      "psm": 3,
      "oem": 3,
      "min_confidence": 0.65,
      "max_scans": 3
    },
    "evidence_extractor": {
      "enabled": true,
      "provider": "local",
      "temperature": 0.0,
      "max_tokens": 950,
      "excerpt_max_chars": 4500
    },
    "set_verdict_engine": {
      "require_verified_identity": true,
      "min_independent_sources": 1,
      "tempo_tolerance_bpm": 2.0,
      "allow_half_double_tempo": true,
      "duration_tolerance_sec": 2,
      "detect_genre_mismatch": true,
      "verdict_labels": {
        "bon": "Bon",
        "faux": "Mauvais",
        "non_trouve": "Inv?rifiable"
      }
    }
  }
}
