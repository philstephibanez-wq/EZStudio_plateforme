{
  "schema": "ezs.orchestrator.config.v5",
  "orchestrator_root": "apps/orchestrator",
  "servers": {
    "dev": {
      "root": "apps/ezstudio_dev",
      "backend_port": 8602,
      "public_port": 8502,
      "allowed_envs": [
        "dev",
        "prod"
      ],
      "default_env": "dev",
      "analysis_python": "apps/ezstudio_dev\\.venv-py313\\Scripts\\python.exe",
      "web_php": "php"
    },
    "prod": {
      "root": "apps/ezstudio",
      "backend_port": 8511,
      "gateway_port": 8510,
      "public_port": 8501,
      "allowed_envs": [
        "prod"
      ],
      "default_env": "prod",
      "analysis_python": "apps/ezstudio\\.venv-py313\\Scripts\\python.exe",
      "web_php": "php"
    },
    "lab": {
      "root": "apps/ezs_lab",
      "backend_port": 8701,
      "public_port": 8702,
      "allowed_envs": [
        "dev"
      ],
      "default_env": "dev",
      "analysis_python": "python",
      "web_php": "php"
    }
  },
  "analysis": {
    "entrypoint": "analysis\\worker_entrypoint.py"
  },
  "resources": {
    "gpu_slots": 1
  },
  "transport": {
    "dev_backend_url": "http://127.0.0.1:8602",
    "prod_backend_url": "http://127.0.0.1:8511",
    "lab_backend_url": "http://127.0.0.1:8701"
  }
}
