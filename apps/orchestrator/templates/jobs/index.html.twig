{% extends 'layout/base.html.twig' %}
{% block title %}EZS Orchestrator — Ordonnanceur{% endblock %}
{% block content %}
<main class="container-fluid py-4 ezs-main">
    <div class="ezs-statusline mb-3 d-flex justify-content-between align-items-center">
        <span><strong>Ordonnanceur</strong> — ordonnancement agnostique (waiting / progressing % / ended)</span>
        <span class="text-body-secondary">Actualisation toutes les 4 s (onglet visible)</span>
    </div>
    <section class="card mb-3" aria-labelledby="queue-title">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong id="queue-title">File globale — Orchestrator (1 job actif maximum)</strong>
            <span id="queue-availability-badge" class="badge {{ global_queue.available ? 'text-bg-success' : 'text-bg-secondary' }}">{{ global_queue.available ? 'Base accessible' : 'Indisponible' }}</span>
        </div>
        <div class="card-body">
            {% set f = global_queue.filters|default({'state':'all','actor':'all','category':'all','limit':30}) %}
            <form method="get" action="/jobs" class="row g-2 align-items-end mb-3">
                <div class="col-auto"><label class="form-label small text-body-secondary mb-1">État</label>
                    <select name="state" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="all" {{ f.state == 'all' ? 'selected' }}>Tous</option>
                        <option value="active" {{ f.state == 'active' ? 'selected' }}>Actifs (attente + cours)</option>
                        <option value="waiting" {{ f.state == 'waiting' ? 'selected' }}>Enregistré (en attente)</option>
                        <option value="progressing" {{ f.state == 'progressing' ? 'selected' }}>En progression</option>
                        <option value="cancelling" {{ f.state == 'cancelling' ? 'selected' }}>Annulation en cours</option>
                        <option value="cancelled" {{ f.state == 'cancelled' ? 'selected' }}>Annulé</option>
                        <option value="ended_ok" {{ f.state == 'ended_ok' ? 'selected' }}>Terminé (OK)</option>
                        <option value="ended_ko" {{ f.state == 'ended_ko' ? 'selected' }}>Terminé (KO)</option>
                    </select></div>
                <div class="col-auto"><label class="form-label small text-body-secondary mb-1">Acteur</label>
                    <select name="actor" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="all" {{ f.actor == 'all' ? 'selected' }}>Tous</option>
                        <option value="lab" {{ f.actor == 'lab' ? 'selected' }}>lab</option>
                        <option value="assistant" {{ f.actor == 'assistant' ? 'selected' }}>assistant</option>
                    </select></div>
                <div class="col-auto"><label class="form-label small text-body-secondary mb-1">Type</label>
                    <select name="category" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="all" {{ f.category == 'all' ? 'selected' }}>Tous</option>
                        <option value="Analyse" {{ f.category == 'Analyse' ? 'selected' }}>Analyse</option>
                        <option value="Expertise" {{ f.category == 'Expertise' ? 'selected' }}>Expertise</option>
                    </select></div>
                <div class="col-auto"><label class="form-label small text-body-secondary mb-1">Afficher</label>
                    <select name="limit" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="20" {{ f.limit == 20 ? 'selected' }}>20</option>
                        <option value="30" {{ f.limit == 30 ? 'selected' }}>30</option>
                        <option value="50" {{ f.limit == 50 ? 'selected' }}>50</option>
                        <option value="100" {{ f.limit == 100 ? 'selected' }}>100</option>
                    </select></div>
                {% if f.state != 'all' or f.actor != 'all' or f.category != 'all' or f.limit != 30 %}
                <div class="col-auto"><a href="/jobs" class="btn btn-outline-secondary btn-sm">Réinitialiser</a></div>
                {% endif %}
            </form>
            <div id="queue-live-region">
            {% if global_queue.available %}
                <p><strong>{{ global_queue.jobs|length }}</strong> affichés (max {{ f.limit }})
                    — en attente : <strong>{{ global_queue.counts.waiting|default(0) }}</strong>
                    — en progression : <strong>{{ global_queue.counts.progressing|default(0) }}</strong>
                    — terminés (OK) : <strong>{{ global_queue.counts.ended_ok|default(0) }}</strong>
                    — terminés (KO) : <strong>{{ global_queue.counts.ended_ko|default(0) }}</strong>
                </p>
                {% set has_any_error = global_queue.jobs|filter(j => j.error_message is not empty)|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-dark table-sm align-middle mb-0">
                        <thead><tr>
                            <th>Job</th><th>Acteur</th><th>Type</th><th>Chanson</th><th>État</th><th style="min-width: 170px;">Progression</th><th>Tentatives</th>{% if has_any_error %}<th>Erreur</th>{% endif %}<th>Dernier événement</th><th class="text-end">Actions</th>
                        </tr></thead>
                        <tbody>
                        {% for job in global_queue.jobs %}
                            <tr>
                                <td>#{{ job.id }}</td>
                                <td><span class="badge text-bg-dark border">{{ job.actor }}</span></td>
                                <td>{{ job.category ?: '—' }}</td>
                                <td>{{ job.label ?: '—' }}</td>
                                <td>
                                    {% if job.state == 'ended' and not job.has_error %}<span class="badge text-bg-success">Terminé (OK)</span>
                                    {% elseif job.state == 'ended' and job.has_error %}<span class="badge text-bg-danger">Terminé (KO)</span>
                                    {% elseif job.state == 'progressing' %}<span class="badge text-bg-primary">En progression</span>
                                    {% elseif job.state == 'cancelling' %}<span class="badge text-bg-warning">Annulation en cours</span>
                                    {% elseif job.state == 'cancelled' %}<span class="badge text-bg-secondary">Annulé</span>
                                    {% if job.subject is defined and (workflow_can(job.subject, 'cancel') or workflow_can(job.subject, 'request_cancel')) %}<span class="badge text-bg-dark border ms-1" title="Annulable via FSM">annulable</span>{% endif %}
                                    {% else %}<span class="badge text-bg-secondary">Enregistré (en attente)</span>{% endif %}
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 8px;">
                                            <div class="progress-bar {{ job.has_error ? 'bg-danger' : (job.state == 'ended' ? 'bg-success' : 'bg-primary') }}" style="width: {{ job.progress }}%;"></div>
                                        </div>
                                        <span class="small text-nowrap">{{ job.progress }} %</span>
                                    </div>
                                </td>
                                <td>{{ job.attempts }}</td>
                                {% if has_any_error %}<td class="small">{% if job.error_message %}<span class="text-danger">{{ job.error_message }}</span>{% else %}<span class="text-body-secondary">—</span>{% endif %}</td>{% endif %}
                                <td>{% if job.updated_at is not empty %}{{ job.updated_at|date('d/m/Y H:i:s', 'Europe/Paris') }}{% else %}—{% endif %}</td><td class="text-end text-nowrap">{% if job.state == 'ended' and job.has_error %}<form method="post" action="/jobs/{{ job.id }}/retry" class="d-inline me-1"><button type="submit" class="btn btn-outline-warning btn-sm py-0 px-2">Relancer</button></form>{% endif %}{% if job.state in ['waiting', 'cancelled', 'ended'] %}<button type="button" class="btn btn-link text-secondary link-light p-0 ms-1 align-middle" data-bs-toggle="modal" data-bs-target="#deleteJobModal" title="Supprimer ce job" aria-label="Supprimer" data-job-id="{{ job.id }}"><svg xmlns="http://w3.org" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/></svg></button>{% else %}—{% endif %}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="{{ has_any_error ? 9 : 8 }}">Aucun job correspondant aux filtres.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="mb-0 text-body-secondary">File globale inaccessible : {{ global_queue.reason }}.</p>
            {% endif %}
            </div>
            <p class="text-body-secondary mt-2 mb-0">Lecture seule : seul l’Ordonnanceur et les acteurs via REST modifient les états.</p>
        </div>
    </section>
<div class="modal fade" id="deleteJobModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content bg-dark text-light border-secondary">
      <div class="modal-header border-secondary py-2">
        <h6 class="modal-title">Supprimer l'entrée</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <div class="modal-body py-3">Supprimer définitivement le job <strong id="deleteJobLabel">#</strong> de la file ?</div>
      <div class="modal-footer border-secondary py-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Annuler</button>
        <form method="post" id="deleteJobForm" action=""><button type="submit" class="btn btn-danger btn-sm">Supprimer</button></form>
      </div>
    </div>
  </div>
</div>
<script>
document.getElementById('deleteJobModal')?.addEventListener('show.bs.modal', function (e) {
  const id = e.relatedTarget?.getAttribute('data-job-id') || '';
  document.getElementById('deleteJobLabel').textContent = '#' + id;
  document.getElementById('deleteJobForm').action = '/jobs/' + id + '/delete';
});
</script>
</main>
<script>
(function () {
    window.setInterval(async function () {
        if (document.visibilityState !== 'visible') return;
        try {
            const response = await fetch(window.location.href, {cache: 'no-store', credentials: 'same-origin'});
            if (!response.ok) return;
            const documentCopy = new DOMParser().parseFromString(await response.text(), 'text/html');
            const currentRegion = document.getElementById('queue-live-region');
            const nextRegion = documentCopy.getElementById('queue-live-region');
            if (currentRegion && nextRegion) currentRegion.replaceWith(document.importNode(nextRegion, true));
            const currentBadge = document.getElementById('queue-availability-badge');
            const nextBadge = documentCopy.getElementById('queue-availability-badge');
            if (currentBadge && nextBadge) currentBadge.replaceWith(document.importNode(nextBadge, true));
        } catch (_) {}
    }, 4000);
}());
</script>
{% endblock %}