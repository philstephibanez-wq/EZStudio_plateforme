<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}EZS Orchestrator{% endblock %}</title>
    <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/ezs-infrastructure.css">
    <script src="/vendor/jquery/jquery-4.0.0.min.js" defer></script>
    <script src="/vendor/bootstrap/bootstrap.bundle.min.js" defer></script>
    <script src="/assets/ezs-gpu-monitor.js?v=gpu6" defer></script>
    {% block page_scripts %}{% endblock %}
</head>
<body>
    <header class="navbar navbar-dark bg-dark">
        <div class="container-fluid">
            <span class="navbar-brand mb-0 h1">EZS Orchestrator <small class="text-secondary">v{{ orchestrator_version }}</small></span>
            <span class="badge text-bg-secondary">DEV · Consultation</span>
        </div>
    </header>
    {% include 'infrastructure/_gpu_monitor.html.twig' %}
    <nav class="ezs-nav" aria-label="Navigation principale">
        <a href="/" {% if active_page == 'infrastructure' %}aria-current="page"{% endif %}>Infrastructure</a>
        <a href="/jobs" {% if active_page == 'jobs' %}aria-current="page"{% endif %}>Ordonnanceur</a>
        <span>Déploiements · en migration</span>
    </nav>
    {% block content %}{% endblock %}
{% if app.environment == 'dev' %}
<footer class="container-fluid py-2 border-top border-secondary-subtle small text-end"><a href="/_profiler" target="_blank" rel="noopener noreferrer" class="link-secondary text-decoration-none">Symfony Profiler</a> <a href="/_profiler-export" style="margin-left:10px;color:#c9d1d9;text-decoration:none;border:1px solid #464c54;padding:2px 8px;border-radius:4px">Export Profiler</a></footer>
{% endif %}
</body>
</html>
