{% extends 'layout/base.html.twig' %}
{% import '@shared/macros/ezs_ui.html.twig' as ezs %}
{% block title %}EZS Orchestrator — Ordonnanceur{% endblock %}
{% block content %}
<main class="container-fluid py-4 ezs-main">
    <div class="ezs-statusline mb-3 d-flex justify-content-between align-items-center">
        <span><strong>Ordonnanceur</strong> — ordonnancement agnostique (waiting / progressing % / ended)</span>
        <span class="text-body-secondary">Actualisation toutes les 4 s (onglet visible)</span>
    </div>
    <div class="alert alert-warning py-2 mb-3" data-ezs-quota-alert hidden role="status"></div>
    {% if flash_error is defined and flash_error is not empty %}<div class="alert alert-danger py-2 mb-3" role="alert">{{ flash_error }}</div>{% endif %}
    {% if queue_paused_on_error|default(false) %}
    <div class="alert alert-danger" role="alert"><strong>FILE SUSPENDUE APRÈS UN JOB KO</strong> — aucun nouveau GO ne sera attribué, y compris après redémarrage EZS. Les jobs en attente sont conservés. {# EZS_FIFO_ACTIVE_RETRY_R1B #}Corrigez la cause, puis cliquez sur « Relancer » sur le seul job KO bloquant ; il repart en priorité et débloque la FIFO après succès.</div>
    {% endif %}
    <section class="card mb-3" aria-labelledby="queue-title">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong id="queue-title">File globale — Orchestrator (1 job actif maximum)</strong>
            <span id="queue-availability-badge" class="badge {{ global_queue.available ? 'text-bg-success' : 'text-bg-secondary' }}">{{ global_queue.available ? 'Base accessible' : 'Indisponible' }}</span>
        </div>
        <div class="card-body">
            {% set f = global_queue.filters|default({'state':'all','actor':'all','category':'all','item':'all','limit':30}) %}
            <form method="get" action="/jobs" class="row g-2 align-items-end mb-3">
                <div class="col-auto"><label class="form-label small text-body-secondary mb-1">État</label>
                    <select name="state" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="all" {{ f.state == 'all' ? 'selected' }}>Tous</option>
                        <option value="active" {{ f.state == 'active' ? 'selected' }}>Actifs (attente + cours)</option>
                        <option value="waiting" {{ f.state == 'waiting' ? 'selected' }}>Enregistré (en attente)</option>
                        <option value="progressing" {{ f.state == 'progressing' ? 'selected' }}>En progression</option>
                        <option value="cancelling" {{ f.state == 'cancelling' ? 'selected' }}>Annulation en cours</option>
                        <option value="blocking" {{ f.state == 'blocking' ? 'selected' }}>Erreur bloquante</option>
                        <option value="ended_ok" {{ f.state == 'ended_ok' ? 'selected' }}>Terminés OK</option>
                        <option value="ended_ko" {{ f.state == 'ended_ko' ? 'selected' }}>Terminés KO</option>
                        <option value="cancelled" {{ f.state == 'cancelled' ? 'selected' }}>Annulés</option>
                    </select></div>
                <div class="col-auto"><label class="form-label small text-body-secondary mb-1">Acteur</label>
                    <select name="actor" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="all" {{ f.actor == 'all' ? 'selected' }}>Tous</option>
                        <option value="lab" {{ f.actor == 'lab' ? 'selected' }}>lab</option>
                    </select></div>
                <div class="col-auto"><label class="form-label small text-body-secondary mb-1">Type</label>
                    <select name="category" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="all" {{ f.category == 'all' ? 'selected' }}>Tous</option>
                        <option value="Analyse" {{ f.category == 'Analyse' ? 'selected' }}>Analyse</option>
                        <option value="Expertise" {{ f.category == 'Expertise' ? 'selected' }}>Expertise</option>
                    </select></div>
                <div class="col-auto"><label class="form-label small text-body-secondary mb-1">Item</label>
                    <select name="item" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="all" {{ f.item|default('all') == 'all' ? 'selected' }}>Tous</option>
                        <option value="Profile" {{ f.item|default('all') == 'Profile' ? 'selected' }}>Profile</option>
                        <option value="Stems" {{ f.item|default('all') == 'Stems' ? 'selected' }}>Stems</option>
                        <option value="Chords" {{ f.item|default('all') == 'Chords' ? 'selected' }}>Chords</option>
                        <option value="Lyrics" {{ f.item|default('all') == 'Lyrics' ? 'selected' }}>Lyrics</option>
                    </select></div>
                <div class="col-auto"><label class="form-label small text-body-secondary mb-1">Afficher</label>
                    <select name="limit" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="20" {{ f.limit == 20 ? 'selected' }}>20</option>
                        <option value="30" {{ f.limit == 30 ? 'selected' }}>30</option>
                        <option value="50" {{ f.limit == 50 ? 'selected' }}>50</option>
                        <option value="100" {{ f.limit == 100 ? 'selected' }}>100</option>
                    </select></div>
                {% if f.state != 'all' or f.actor != 'all' or f.category != 'all' or f.item|default('all') != 'all' or f.limit != 30 %}
                <div class="col-auto"><a href="/jobs" class="btn btn-outline-secondary btn-sm">Réinitialiser</a></div>
                {% endif %}
            </form>
            <div id="queue-live-region">
            {% if global_queue.available %}
                <p><strong>{{ global_queue.jobs|length }}</strong> affichés (max {{ f.limit }})
                    — en attente : <strong>{{ global_queue.counts.waiting|default(0) }}</strong>
                    — en progression : <strong>{{ global_queue.counts.progressing|default(0) }}</strong>
                    — erreur bloquante : <strong>{{ global_queue.counts.blocking|default(0) }}</strong>
                     — terminés OK : <strong>{{ global_queue.counts.ended_ok|default(0) }}</strong>
                     — terminés KO : <strong>{{ global_queue.counts.ended_ko|default(0) }}</strong>
                     — annulés : <strong>{{ global_queue.counts.cancelled|default(0) }}</strong>
                </p>
                {% set has_any_error = global_queue.jobs|filter(j => j.error_message is not empty)|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-dark table-sm align-middle mb-0">
                        <thead><tr>
                            <th>Job</th><th>Acteur</th><th>Type</th><th>Item</th><th>Chanson</th><th>État</th><th style="min-width: 170px;">Progression</th><th>Tentatives</th>{% if has_any_error %}<th>Erreur</th>{% endif %}<th>Dernier événement</th><th class="text-end">Actions</th>
                        </tr></thead>
                        <tbody>
                        {% for job in global_queue.jobs %}
                            <tr>
                                <td>#{{ job.id }}</td>
                                <td><span class="badge text-bg-dark border">{{ job.actor }}</span></td>
                                <td>{{ ezs.phase_badge(job.category) }}</td>
                                <td>{{ ezs.item_badge(job.item) }}</td>
                                <td>{{ job.label ?: '—' }}</td>
                                <td>{{ ezs.state_badge(job.state, job.has_error) }}</td>
                                <td>
                                    {% if job.category == 'Expertise' and job.state == 'progressing' and job.progress == 0 %}
                                    <div class="d-flex align-items-center gap-2"><span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span><span class="small">En cours</span></div>
                                    {% else %}
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 8px;">
                                            <div class="progress-bar {{ job.has_error ? 'bg-danger' : (job.state == 'ended' ? 'bg-success' : 'bg-primary') }}" style="width: {{ job.progress }}%;"></div>
                                        </div>
                                        <span class="small text-nowrap">{{ job.progress }} %</span>
                                    </div>
                                    {% endif %}
                                </td>
                                <td>{{ job.attempts }}</td>
                                {% if has_any_error %}<td class="small">{% if job.error_message %}<span class="text-danger">{{ job.error_message }}</span>{% else %}<span class="text-body-secondary">—</span>{% endif %}</td>{% endif %}
                                <td>{% if job.updated_at is not empty %}{{ job.updated_at|date('d/m/Y H:i:s', 'Europe/Paris') }}{% else %}—{% endif %}</td><td class="text-end text-nowrap">{% if job.state == 'ended' and job.has_error and job.id == queue_blocked_job_id|default(0) %}<form method="post" action="/jobs/{{ job.id }}/retry" class="d-inline me-1"><input type="hidden" name="_token" value="{{ retry_tokens[job.id]|default('') }}"><button type="submit" class="btn btn-outline-warning btn-sm py-0 px-2">Relancer</button></form>{% endif %}{% if job.state == 'waiting' %}<button type="button" class="btn btn-link text-secondary link-light p-0 ms-1 align-middle" data-bs-toggle="modal" data-bs-target="#deleteJobModal" title="Supprimer ce job" aria-label="Supprimer" data-job-id="{{ job.id }}" data-csrf-token="{{ delete_tokens[job.id]|default('') }}"><svg xmlns="http://w3.org" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/></svg></button>{% else %}—{% endif %}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="{{ has_any_error ? 10 : 9 }}">Aucun job correspondant aux filtres.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="mb-0 text-body-secondary">File globale inaccessible : {{ global_queue.reason }}.</p>
            {% endif %}
            </div>
            <p class="text-body-secondary mt-2 mb-0">Lecture seule : seul l’Ordonnanceur et les acteurs via REST modifient les états.</p>
        </div>
    </section>
<div class="modal fade" id="deleteJobModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content bg-dark text-light border-secondary">
      <div class="modal-header border-secondary py-2">
        <h6 class="modal-title">Supprimer l'entrée</h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <div class="modal-body py-3">Supprimer définitivement le job <strong id="deleteJobLabel">#</strong> de la file ?</div>
      <div class="modal-footer border-secondary py-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Annuler</button>
        <form method="post" id="deleteJobForm" action=""><input type="hidden" name="_token" id="deleteJobToken" value=""><button type="submit" class="btn btn-danger btn-sm">Supprimer</button></form>
      </div>
    </div>
  </div>
</div>
<script>
document.getElementById('deleteJobModal')?.addEventListener('show.bs.modal', function (e) {
  const id = e.relatedTarget?.getAttribute('data-job-id') || '';
  document.getElementById('deleteJobLabel').textContent = '#' + id;
  document.getElementById('deleteJobForm').action = '/jobs/' + id + '/delete';
  document.getElementById('deleteJobToken').value = e.relatedTarget?.getAttribute('data-csrf-token') || '';
});
</script>
</main>
<script>
// EZS_JOBS_FILTERS_PERSIST_R1: URL explicit filters take precedence; last
// selection is restored when revisiting /jobs without query parameters.
(function () {
    const KEY = 'ezs.orchestrator.jobs.filters.v1';
    const names = ['state', 'actor', 'category', 'item', 'limit'];
    const allowed = {
        state: ['all','active','waiting','progressing','cancelling','ended_ko','ended_ok','cancelled','blocking'],
        actor: ['all','lab'],
        category: ['all','Analyse','Expertise'],
        item: ['all','Profile','Stems','Chords','Lyrics'],
        limit: ['20','30','50','100']
    };
    try {
        const params = new URLSearchParams(window.location.search);
        const anyExplicit = names.some(name => params.has(name));
        if (!anyExplicit) {
            const previous = JSON.parse(window.localStorage.getItem(KEY) || 'null');
            if (previous && typeof previous === 'object') {
                const next = new URLSearchParams();
                for (const name of names) {
                    if (allowed[name].includes(previous[name])) next.set(name, previous[name]);
                }
                if ([...next].length) {
                    window.location.replace('/jobs?' + next.toString());
                    return;
                }
            }
        } else {
            const form = document.querySelector('form[method="get"][action="/jobs"]');
            if (form) {
                const saved = {};
                for (const name of names) {
                    const value = form.elements.namedItem(name)?.value;
                    if (allowed[name].includes(value)) saved[name] = value;
                }
                window.localStorage.setItem(KEY, JSON.stringify(saved));
            }
        }
        const reset = document.querySelector('a[href="/jobs"].btn-outline-secondary');
        reset?.addEventListener('click', function () { window.localStorage.removeItem(KEY); });
    } catch (_) { /* Private mode / disabled storage: preserve GET behavior. */ }
}());
</script>
<script>
(function () {
    window.setInterval(async function () {
        if (document.visibilityState !== 'visible') return;
        try {
            const response = await fetch(window.location.href, {cache: 'no-store', credentials: 'same-origin'});
            if (!response.ok) return;
            const documentCopy = new DOMParser().parseFromString(await response.text(), 'text/html');
            const currentRegion = document.getElementById('queue-live-region');
            const nextRegion = documentCopy.getElementById('queue-live-region');
            if (currentRegion && nextRegion) currentRegion.replaceWith(document.importNode(nextRegion, true));
            const currentBadge = document.getElementById('queue-availability-badge');
            const nextBadge = documentCopy.getElementById('queue-availability-badge');
            if (currentBadge && nextBadge) currentBadge.replaceWith(document.importNode(nextBadge, true));
            // EZS_R1H_FIFO_ALERT: a GO in progress excludes a blocking KO by FIFO contract.
            // Keep the alert in sync with the fetched document instead of leaving stale HTML.
            const currentAlerts = Array.from(document.querySelectorAll('main .alert, main [role="alert"], main [id*="pause"], main [class*="pause"]'));
            const incomingAlerts = Array.from(documentCopy.querySelectorAll('main .alert, main [role="alert"], main [id*="pause"], main [class*="pause"]'));
            const suspended = el => (el.textContent || '').includes('FILE SUSPENDUE APRÈS UN JOB KO');
            const currentPause = currentAlerts.find(suspended);
            const nextPause = incomingAlerts.find(suspended);
            const live = document.getElementById('queue-live-region');
            const progresses = Array.from(live?.querySelectorAll('strong') || []);
            const progressing = progresses.some(el =>
                /en progression\s*:/i.test(el.previousSibling?.textContent || '') && Number(el.textContent.trim()) > 0);
            if (currentPause) {
                currentPause.hidden = progressing || !nextPause;
                if (!progressing && nextPause) currentPause.innerHTML = nextPause.innerHTML;
            } else if (nextPause && !progressing) {
                document.querySelector('main .ezs-statusline')?.after(document.importNode(nextPause, true));
            }
            // The displayed blocking count is not allowed to contradict a running GO.
            if (progressing && live) {
                for (const n of Array.from(live.querySelectorAll('strong'))) {
                    if (/erreur bloquante\s*:/i.test(n.previousSibling?.textContent || '')) n.textContent = '0';
                }
            }
        } catch (_) {}
    }, 4000);
}());
</script>
{% endblock %}